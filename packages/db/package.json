{
  "name": "@lantern/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "generate": "prisma generate",
    "migrate": "node ../../tools/with-env.mjs npx prisma migrate dev",
    "deploy": "node ../../tools/with-env.mjs npx prisma migrate deploy",
    "studio": "node ../../tools/with-env.mjs npx prisma studio",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist .turbo",
    "push": "node ../../tools/with-env.mjs npx prisma db push"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0"
  },
  "devDependencies": {
    "@lantern/tsconfig": "workspace:*",
    "prisma": "^5.20.0",
    "typescript": "^5.6.3"
  }
}
