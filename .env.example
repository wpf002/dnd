# ---- Database ----
# SQLite by default — file-based, zero ops. For hosted Postgres (deploy-time),
# switch the provider in packages/db/prisma/schema.prisma and point this at it.
DATABASE_URL="file:../../../data/lantern.db"

# ---- Flint: provider credentials (server-side only, never in apps/web) ----
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# ---- Flint: behavior ----
FLINT_LOG_LEVEL="info"              # silent | error | info | debug
FLINT_TELEMETRY_PATH="./telemetry"  # ndjson call log; feeds the Davis benchmark
FLINT_DEFAULT_PROVIDER="anthropic"
FLINT_REPLAY_MODE="off"             # off | record | replay  (deterministic tests)

# ---- API ----
API_PORT="3001"
API_HOST="0.0.0.0"

# ---- Web ----
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_ART_CDN=""
