# ---- Database ----
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lantern?schema=public"

# ---- Flint: provider credentials (server-side only, never in apps/web) ----
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# ---- Flint: behavior ----
FLINT_LOG_LEVEL="info"              # silent | error | info | debug
FLINT_TELEMETRY_PATH="./telemetry"  # ndjson call log; feeds the Flint benchmark
FLINT_DEFAULT_PROVIDER="anthropic"
FLINT_REPLAY_MODE="off"             # off | record | replay  (deterministic tests)

# ---- API ----
API_PORT="3001"
API_HOST="0.0.0.0"

# ---- Web ----
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_ART_CDN=""
