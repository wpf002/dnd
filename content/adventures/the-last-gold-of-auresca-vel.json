      "onExit": [],
      "terminal": false
    },
    {
      "id": "ending-overload-sacrifice",
      "kind": "ending",
      "title": "The Last Sunrise",
      "prose": "The Aurelian Heart blazes one final time, a second dawn that scours the encroaching dark from the land for a hundred miles. Auresca Vel burns to embers and memory, but the outer villages, the farms, the refugees on the roads—they live. Songs will be sung of the golden city that gave itself so others could see another morning.",
      "art": "art-the-last-gold-of-auresca-vel-heart-overload-blaze",
      "options": [],
      "improvBudget": 6,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": true
    },
    {
      "id": "ending-redirect-transformation",
      "kind": "ending",
      "title": "The New Dawn",
      "prose": "The lever turns true. The Aurelian Heart does not die but changes, its failing light folding inward and blooming outward again as something stranger and stronger—a city no longer golden but luminous in ways no one has named yet. Auresca Vel survives, transfigured, its people waking into a future none of them expected but all of them will come to call home.",
      "art": "art-the-last-gold-of-auresca-vel-city-transformed-dawn",
      "options": [],
      "improvBudget": 6,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": true
    },
    {
      "id": "ending-evacuation-embers",
      "kind": "ending",
      "title": "Embers on the Water",
      "prose": "The Heart dims to nothing, gently, as you and Captain Kane's guard funnel the last citizens through the gates and down to the harbor. Auresca Vel sinks slowly into dusk behind the fleeing ships, its golden towers going dark one by one—not a death, but a long, quiet ending, witnessed by everyone who lived to see it.",
      "art": "art-the-last-gold-of-auresca-vel-evacuation-embers-fleet",
      "options": [],
      "improvBudget": 6,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": true
    },
    {
      "id": "ending-fall-of-the-city",
      "kind": "ending",
      "title": "The Unmade City",
      "prose": "The lever slips, or the ritual falters, or the guardians were never truly cleared. The Aurelian Heart collapses in on itself, uncontrolled, and Auresca Vel falls silent all at once—towers, gates, and golden light swallowed by a dark that does not flicker. Somewhere far off, survivors will tell of a city that simply stopped, and wonder what final choice was made too late.",
      "art": "art-the-last-gold-of-auresca-vel-city-collapse-ruin",
      "options": [],
      "improvBudget": 6,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": true
    }
