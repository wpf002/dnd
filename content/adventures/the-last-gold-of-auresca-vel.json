    {
      "id": "the-last-choice",
      "kind": "decision",
      "title": "One Lever Left",
      "prose": "The Heart shudders, seconds from collapse. Archon Marrow steps back. The lever is yours to pull.",
      "art": "art-the-last-gold-of-auresca-vel-final-lever-decision",
      "options": [
        {
          "id": "pull-overload",
          "label": "Overload the Heart to scour back the encroaching dark and save the outer lands",
          "target": "ending-overload-sacrifice",
          "effects": []
        },
        {
          "id": "pull-redirect",
          "label": "Redirect the Heart's power to transform the city into something new",
          "visibleWhen": {
            "op": "and",
            "clauses": [
              {
                "op": "eq",
                "flag": "lever-primed",
                "value": true
              },
              {
                "op": "or",
                "clauses": [
                  {
                    "op": "eq",
                    "flag": "ritual-known",
                    "value": true
                  },
                  {
                    "op": "eq",
                    "flag": "choir-trust",
                    "value": true
                  }
                ]
              }
            ]
          },
          "target": "ending-redirect-transformation",
          "effects": []
        },
        {
          "id": "pull-shutdown",
          "label": "Shut the Heart down and lead the evacuation while there's still time",
          "target": "ending-evacuation-embers",
          "effects": [],
          "requiresCheck": {
            "ability": "wis",
            "skill": "survival",
            "dc": 14,
            "onFailure": "ending-fall-of-the-city"
