      "onExit": [],
      "terminal": false
    },
    {
      "id": "sun-gate-crowds",
      "kind": "social",
      "title": "Chaos at the Gate",
      "prose": "Captain Doreth Kane of the city guard fights to hold a line against a surging, terrified crowd as golden dust sifts down from the failing wards above. Every choice here costs time you don't have.",
