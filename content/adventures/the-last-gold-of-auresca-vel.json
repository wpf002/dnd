    {
      "id": "vesper-ritual-lore",
      "kind": "puzzle",
      "title": "The Ritual of Unmaking",
      "prose": "Vesper Ilanya, First Voice of the Choir, unrolls a ritual script older than the city's golden age. 'The Heart can be overloaded, redirected, or stilled,' she says, 'but the lever must be primed correctly, or all three fail at once.'",
      "art": "art-the-last-gold-of-auresca-vel-ritual-script-scroll",
      "options": [
        {
          "id": "decipher-ritual-script",
          "label": "Decipher the ritual script yourself",
          "target": "lever-chamber",
          "effects": [
