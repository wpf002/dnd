{
  "id": "the-last-gold-of-auresca-vel",
  "schemaVersion": 1,
  "metadata": {
    "title": "The Last Gold of Auresca Vel",
    "premise": "In the golden city of Auresca Vel, the failing Aurelian Heart has only hours left before its light dies forever—and only one lever remains to decide whether the city burns to save the land, transforms into something new, or falls silent into the dark.",
    "tone": [
      "epic-finale",
      "political-fantasy"
    ],
    "tier": "national",
    "partyLevel": 10,
    "narrationVoice": "A weary herald chronicling the city's final hours, equal parts elegy and urgency.",
    "contentLimits": {
      "exclude": [
        "harm to children depicted on-screen"
      ],
      "note": "No on-screen harm to children; refugee children may be mentioned as present but never endangered on-page."
    },
    "provenance": "flint"
  },
  "entry": "threshold-arrival",
  "beats": [
    {
      "id": "threshold-arrival",
      "kind": "threshold",
      "title": "The Sun Gate at Dusk",
      "prose": "The last gold of Auresca Vel bleeds across the sky as the Aurelian Heart flickers in its tower above the city. Refugees clog the Sun Gate; smugglers whisper of tunnels beneath; and somewhere in a hidden sanctum, the Choir of Radiance prepares a ritual no outsider has ever witnessed. You have hours—perhaps less—before the Heart's light fails and its wards fall with it.",
      "art": "art-the-last-gold-of-auresca-vel-golden-city-dusk-gate",
      "options": [
        {
          "id": "approach-sun-gate",
          "label": "Push through the panicked crowds at the Sun Gate",
          "target": "sun-gate-crowds",
          "effects": []
        },
        {
          "id": "slip-undertow-tunnels",
          "label": "Slip into the Undertow smugglers' tunnels beneath the city",
          "target": "undertow-tunnels",
          "effects": [],
          "requiresCheck": {
            "ability": "dex",
            "skill": "stealth",
            "dc": 15,
            "onFailure": "sun-gate-crowds"
          }
        },
        {
          "id": "seek-choir-sanctum",
          "label": "Seek the Choir of Radiance's hidden sanctum entrance",
          "target": "choir-sanctum-approach",
          "effects": [],
          "requiresCheck": {
            "ability": "wis",
            "skill": "insight",
            "dc": 13,
            "onFailure": "sun-gate-crowds"
          }
        }
      ],
