    {
      "id": "the-failing-heart",
      "kind": "discovery",
      "title": "The Aurelian Heart",
      "prose": "In the palace's central tower, the Aurelian Heart pulses like a dying star, and Archon Selwyn Marrow—last steward of Auresca Vel—stands before it, hollow-eyed. 'One lever remains,' he says. 'One choice, and one chance to make it.' Three paths lie open before the hour runs out.",
      "art": "art-the-last-gold-of-auresca-vel-aurelian-heart-chamber",
      "options": [
        {
          "id": "investigate-heart-chamber",
          "label": "Investigate the Heart chamber directly",
          "target": "heart-chamber-guardians",
          "effects": []
        },
        {
          "id": "negotiate-with-senate",
          "label": "Negotiate with the Ashen Senate for their cooperation",
          "target": "senate-negotiation",
          "effects": []
        },
        {
          "id": "consult-vesper-ritual",
          "label": "Consult Vesper of the Choir on the ritual's true nature",
          "target": "vesper-ritual-lore",
          "effects": []
        }
      ],
      "improvBudget": 8,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": false
    },
    {
      "id": "senate-negotiation",
      "kind": "social",
      "title": "The Ashen Senate's Demands",
      "prose": "The Ashen Senate has gathered its remaining wealth into carts, arguing over who deserves a place on the last ships out. They will help—for a price, or under threat.",
      "art": "art-the-last-gold-of-auresca-vel-ashen-senate-hall",
      "options": [
        {
          "id": "bribe-senate",
          "label": "Offer the Senate a share of the Heart's remaining gold reserves",
          "target": "vesper-ritual-lore",
          "effects": [
            {
              "flag": "senate-favor",
              "value": true
            }
          ]
        },
        {
          "id": "threaten-senate",
          "label": "Threaten the Senate with the guard's authority",
          "target": "vesper-ritual-lore",
          "effects": [],
