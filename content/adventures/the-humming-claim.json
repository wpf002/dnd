    {
      "id": "singing-river-crossing",
      "kind": "hazard",
      "title": "The Chord River",
      "prose": "A river of quicksilver water sings in shifting harmonies, and each note seems to tug at the stones beneath your boots. Fording it wrong could sweep you into the canyon's throat.",
      "art": "art-the-humming-claim-river-of-song",
      "options": [
        {
          "id": "calm-the-song",
          "label": "Sing back to calm the river's magic",
          "target": "chime-grove",
          "effects": [],
          "requiresCheck": {
            "ability": "cha",
