    {
      "id": "guardian-of-the-deep-claim",
      "kind": "climax",
      "title": "The Guardian of the Deep Claim",
      "prose": "At the mine's throat stands a suit of armor fused with gold ore, animated by the canyon's own restless noise, flanked by rattling bones that were once careless prospectors.",
      "art": "art-the-humming-claim-guardian-armor-clash",
      "options": [],
