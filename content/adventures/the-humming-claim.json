            "skill": "religion",
            "dc": 11,
            "onFailure": "claim-jumpers-ambush"
          }
        },
        {
          "id": "loot-remains",
          "label": "Search the remains quickly for anything useful",
          "target": "guardian-of-the-deep-claim",
          "effects": [],
