    {
      "id": "resonant-vein-puzzle",
      "kind": "puzzle",
      "title": "The Resonant Vein",
      "prose": "The canyon narrows into a wall of gold-shot rock that hums a shifting, layered chord. Somewhere in that pattern is a path through; get it wrong and the wall answers with an avalanche of sound and stone.",
      "art": "art-the-humming-claim-vein-puzzle-chamber",
      "options": [
        {
          "id": "follow-map",
          "label": "Follow the safe pattern you already know",
          "visibleWhen": {
            "op": "eq",
            "flag": "knows-safe-path",
            "value": true
          },
          "target": "lost-camp",
          "effects": []
        },
        {
          "id": "solve-by-listening",
          "label": "Attempt to solve the humming pattern by ear",
          "target": "lost-camp",
          "effects": [],
          "requiresCheck": {
            "ability": "int",
            "skill": "arcana",
            "dc": 14,
            "onFailure": "guardian-of-the-deep-claim"
          }
        },
        {
          "id": "brute-force-vein",
          "label": "Ignore the puzzle and force a way through the wall",
          "target": "guardian-of-the-deep-claim",
          "effects": []
        }
      ],
      "improvBudget": 8,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": false
    },
    {
      "id": "lost-camp",
      "kind": "discovery",
      "title": "The Lost Camp",
      "prose": "Tents long collapsed, tools rusted with strange verdigris, and bones picked clean by something patient. This is where the other expeditions ended. A locket among the ashes bears Mabel Thorn's initials.",
      "art": "art-the-humming-claim-lost-camp-remains",
      "options": [
        {
          "id": "bury-remains",
          "label": "Take time to bury the dead properly",
          "target": "guardian-of-the-deep-claim",
