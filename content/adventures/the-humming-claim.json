      "terminal": false
    },
    {
      "id": "gilt-cuckoo-bargain",
      "kind": "social",
      "title": "The Gilt Cuckoo's Bargain",
      "prose": "The fey unfolds into something man-sized, feathered in gold leaf, its voice a chorus of stolen mining-camp songs. It calls itself the Gilt Cuckoo, keeper of the canyon's echoes, and it is delighted to make a deal.",
      "art": "art-the-humming-claim-cuckoo-court-clearing",
      "options": [
        {
          "id": "bargain-gold-for-secret",
          "label": "Trade a future share of gold for the safe route's secret",
          "visibleWhen": {
