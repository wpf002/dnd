    {
      "id": "trailhead-warning",
      "kind": "decision",
      "title": "The Widow's Grade",
      "prose": "A leaning signpost, its letters etched by claw or chisel, reads: TURN BACK, IT SINGS FOR YOU TOO. Beyond it, the trail vanishes into a canyon where the very air seems to ring like struck crystal.",
      "art": "art-the-humming-claim-trailhead-sign-post",
      "options": [
        {
          "id": "enter-cautious",
          "label": "Advance carefully, testing the ground for humming veins",
          "target": "singing-river-crossing",
          "effects": []
        },
        {
          "id": "enter-bold",
          "label": "Push forward boldly, trusting speed over caution",
          "target": "singing-river-crossing",
          "effects": [
            {
              "flag": "bold-approach",
              "value": true
            }
          ]
        },
        {
          "id": "guide-shortcut",
          "label": "Follow rumors of a fey-touched shortcut through the grove",
          "target": "chime-grove",
          "effects": [],
          "requiresCheck": {
            "ability": "wis",
            "skill": "survival",
            "dc": 13,
            "onFailure": "singing-river-crossing"
