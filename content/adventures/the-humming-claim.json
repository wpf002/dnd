    {
      "id": "the-heart-of-the-mountain",
      "kind": "decision",
      "title": "The Heart of the Mountain",
      "prose": "Past the guardian's ruin lies the source of it all: a cavern where veins of gold pulse and sing in a single vast, aching chord, and pale echoes of the missing drift like smoke among the ore.",
      "art": "art-the-humming-claim-heart-of-mountain-chamber",
      "options": [
        {
          "id": "claim-the-gold",
          "label": "Claim the singing gold vein for Tumble Forks",
          "visibleWhen": {
            "op": "not",
            "clause": {
              "op": "eq",
              "flag": "fey-debt",
              "value": true
            }
          },
          "target": "ending-golden-boom",
          "effects": []
        },
        {
          "id": "free-the-spirits",
          "label": "Free the trapped echoes instead of taking the gold",
          "target": "ending-freed-chorus",
          "effects": [],
          "requiresCheck": {
            "ability": "wis",
            "skill": "arcana",
            "dc": 14,
            "onFailure": "ending-swallowed-by-wilderness"
          }
        },
        {
          "id": "seal-the-route",
          "label": "Seal the vein forever, ending the deaths at the cost of the gold",
          "target": "ending-sealed-mountain",
          "effects": []
        }
      ],
      "improvBudget": 8,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": false
    },
    {
      "id": "ending-golden-boom",
      "kind": "ending",
      "title": "The Golden Boom",
      "prose": "The vein is claimed, and Tumble Forks roars back to life louder than ever, its streets ringing with new fortune. But at night, some swear the gold still hums a mourning note beneath the celebration.",
      "art": "art-the-humming-claim-golden-boom-epilogue",
      "options": [],
      "improvBudget": 6,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": true
    },
    {
      "id": "ending-freed-chorus",
      "kind": "ending",
      "title": "The Freed Chorus",
      "prose": "The trapped echoes rise into the sky like a flock of silver birds, and the canyon falls into a gentler, kinder hum. Tumble Forks survives on smaller finds, but no one else is ever lost to the Widow's Grade again.",
      "art": "art-the-humming-claim-freed-chorus-epilogue",
      "options": [],
      "improvBudget": 6,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": true
    },
    {
      "id": "ending-sealed-mountain",
      "kind": "ending",
      "title": "The Sealed Mountain",
      "prose": "You bring the vein down in a roar of gold dust and silence. The Widow's Grade falls quiet at last. Tumble Forks will have to find its fortune elsewhere, but its graveyard stops growing.",
      "art": "art-the-humming-claim-sealed-mountain-epilogue",
      "options": [],
      "improvBudget": 6,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": true
    },
    {
      "id": "ending-swallowed-by-wilderness",
      "kind": "ending",
      "title": "Swallowed by the Wilderness",
      "prose": "The canyon's song rises to a deafening chord, and the last thing you hear is your own name sung back at you in a stranger's voice. Somewhere in Tumble Forks, a new tally mark is chalked beside the others, and someone begins writing a map for the next fools brave enough to try.",
      "art": "art-the-humming-claim-swallowed-wilderness-epilogue",
      "options": [],
      "improvBudget": 6,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": true
    }
