    {
      "id": "claim-jumpers-ambush",
      "kind": "conflict",
      "title": "Ambush at the Claim Stakes",
      "prose": "Rival prospectors, driven half-mad by the canyon's noise, burst from the rocks with pickaxes and stolen guns, howling over a claim that was never theirs.",
      "art": "art-the-humming-claim-ambush-claim-stakes",
      "options": [],
