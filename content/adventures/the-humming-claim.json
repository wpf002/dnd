    {
      "id": "chime-grove",
      "kind": "discovery",
      "title": "The Chime Grove",
      "prose": "Bells of frozen dew hang from silver branches, ringing without wind. Something small and bright watches you from the hollow of an upturned root, grinning far too wide for its size.",
      "art": "art-the-humming-claim-grove-of-chimes",
      "options": [
        {
          "id": "accept-bargain",
          "label": "Accept the creature's offer of safe passage",
          "target": "gilt-cuckoo-bargain",
          "effects": []
        },
        {
          "id": "refuse-bargain",
          "label": "Politely refuse and press onward alone",
          "target": "resonant-vein-puzzle",
          "effects": []
        },
        {
          "id": "steal-trinket",
          "label": "Try to pilfer a charm from its hoard of ringing trinkets",
          "target": "gilt-cuckoo-bargain",
          "effects": [],
          "requiresCheck": {
            "ability": "dex",
