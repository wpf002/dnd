      "gothic-horror",
      "high-adventure"
    ],
    "tier": "local",
    "partyLevel": 4,
    "narrationVoice": "A somber, atmospheric narrator who lingers on decay and half-remembered guilt.",
    "contentLimits": {
      "exclude": [
        "harm to children depicted on-screen"
      ],
      "note": "No child characters are harmed or threatened on-screen anywhere in this adventure."
    },
    "provenance": "flint"
  },
