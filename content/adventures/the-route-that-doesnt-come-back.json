{
  "id": "the-route-that-doesnt-come-back",
  "schemaVersion": 1,
  "metadata": {
    "title": "The Route That Doesn't Come Back",
    "premise": "The debt-ridden crew of the freighter Gray Wren must run the Hollow Passage—a smugglers' lane where three ships have vanished without a trace—to deliver a cargo that could finally clear their crushing debt, and a garbled signal from a lost crewmate gives them a reason to believe they might come back this time.",
    "tone": [
      "exploration",
      "heist"
    ],
    "tier": "local",
    "partyLevel": 4,
    "narrationVoice": "Wry, weather-beaten second-person narrator speaking directly to the crew, equal parts salt spray and gallows humor.",
    "contentLimits": {
      "exclude": [
        "harm to children depicted on-screen"
      ],
      "note": "No children appear on-page; keep threats aimed at adult crew and salvage, not minors."
    },
    "provenance": "flint"
  },
  "entry": "debt-call",
  "beats": [
    {
      "id": "debt-call",
      "kind": "threshold",
      "title": "The Ledger Comes Due",
      "prose": "Factor Ilsa Corvane of the Saltmere Ledger House lays a stack of overdue notices on the table between you. The Gray Wren owes more than her hull is worth. Corvane offers one way out: run a cargo through the Hollow Passage, a lane that has swallowed three ships whole. Pay clears everything. Refusal means the debt collectors take the ship by morning.",
      "readAloud": "\"Three ships in, none out,\" Corvane says, not unkindly. \"But the fourth time's rates are excellent. What'll it be?\"",
      "art": "art-the-route-that-doesnt-come-back-debt-call-art",
      "options": [
        {
          "id": "take-the-job",
          "label": "Accept the ledger's desperate offer",
          "visibleWhen": {
            "op": "always"
          },
          "target": "tallow-reach",
          "effects": []
        },
        {
          "id": "ask-about-losses",
          "label": "Press Corvane about why no ship has returned",
          "visibleWhen": {
            "op": "always"
          },
          "target": "tallow-reach",
          "effects": []
        },
        {
          "id": "refuse-job",
          "label": "Refuse the job and gamble on the debt collectors",
          "visibleWhen": {
