    {
      "id": "into-the-passage",
      "kind": "transit",
      "title": "Into the Hollow Passage",
      "prose": "The fog swallows the Gray Wren whole. Half-sunk masts jut from the water like broken teeth, and the compass needle spins lazily, uncertain of true north.",
      "readAloud": "Something out in the fog answers your foghorn a half-second before you sound it.",
      "art": "art-the-route-that-doesnt-come-back-into-the-passage-art",
      "options": [
        {
          "id": "follow-charts",
          "label": "Follow the charted safe lane precisely",
          "visibleWhen": {
            "op": "eq",
