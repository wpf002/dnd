    {
      "id": "choose-approach",
      "kind": "decision",
      "title": "Getting the Charts",
      "prose": "No safe charts of the Hollow Passage exist in any honest ledger. The old harbor charts are locked in a warehouse under guard, and there's more than one way to get at them.",
      "readAloud": "\"Whoever has the true lane through that passage,\" the fixer murmurs, \"has the only thing worth having tonight.\"",
      "art": "art-the-route-that-doesnt-come-back-choose-approach-art",
      "options": [
        {
          "id": "bribe-harbormaster",
          "label": "Bribe the harbormaster for the warehouse key",
          "visibleWhen": {
            "op": "always"
          },
          "target": "warehouse-heist",
          "effects": [
            {
              "flag": "approach",
              "value": "bribe"
