    {
      "id": "captains-logs",
      "kind": "puzzle",
      "title": "The Dead Captain's Logs",
      "prose": "The vault holds charts, yes, but also the log of a captain who never came back. His handwriting grows shakier page by page, marking a lane through the passage that might still hold true.",
      "readAloud": "The final legible entry reads: \"Follow the drowned lights. Do not answer them.\"",
      "art": "art-the-route-that-doesnt-come-back-captains-logs-art",
      "options": [
        {
          "id": "study-logs",
          "label": "Study the captain's logs for the safe lane",
