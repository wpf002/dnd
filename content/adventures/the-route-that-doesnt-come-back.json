    {
      "id": "first-wreck",
      "kind": "discovery",
      "title": "The Widow's Bell",
      "prose": "The first wreck looms out of the fog: the Widow's Bell, the last ship lost on this route. Scratched into the hull near the waterline, fresh and deliberate, are the initials M.T. — Mika Thorne, your rigger, gone three months and presumed drowned.",
      "readAloud": "The scratches are shallow, recent. Someone made those marks after the wreck settled, not before.",
      "art": "art-the-route-that-doesnt-come-back-first-wreck-art",
      "options": [
        {
          "id": "search-wreck",
          "label": "Search the wreck's cabins for survivors or clues",
          "visibleWhen": {
            "op": "always"
          },
          "target": "drowned-ambush",
          "effects": []
        },
        {
          "id": "salvage-cargo",
          "label": "Salvage what cargo remains before moving on",
          "visibleWhen": {
