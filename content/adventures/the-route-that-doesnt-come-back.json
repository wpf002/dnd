    {
      "id": "ending-debt-cleared",
      "kind": "ending",
      "title": "The Ledger Closes",
      "prose": "The Gray Wren limps back into Saltmere riding low with salvage. Factor Corvane counts the cargo twice, then tears the debt notice in half. You're free — poorer in nerve, richer in nothing but breathing room, and that's enough.",
      "art": "art-the-route-that-doesnt-come-back-ending-debt-cleared-art",
      "options": [],
      "improvBudget": 6,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": true
    },
    {
      "id": "ending-mika-freed",
      "kind": "ending",
      "title": "What the Sea Gave Back",
      "prose": "You leave most of the cargo behind, and Mika Thorne walks off the gangplank under her own power, blinking at real sunlight for the first time in months. The debt remains, but the Widowmark crew, bound by the salvage they did take, promises to help you find another way to pay it. Some things are worth more than a clean ledger.",
      "art": "art-the-route-that-doesnt-come-back-ending-mika-freed-art",
      "options": [],
      "improvBudget": 6,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": true
    },
    {
      "id": "ending-sea-legend",
      "kind": "ending",
      "title": "The Crew That Came Back",
      "prose": "You keep the treasure, skip the delivery, and vanish from Saltmere's ledgers entirely. The Gray Wren becomes a story told in ports far from here: the only crew to run the Hollow Passage and return with more than they went in with. The debt collectors are still looking. Let them.",
      "art": "art-the-route-that-doesnt-come-back-ending-sea-legend-art",
      "options": [],
      "improvBudget": 6,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": true
    },
    {
      "id": "ending-debtors-prison",
      "kind": "ending",
      "title": "The Ledger Collects",
      "prose": "Whether by refusal, capture, or the cold grip of the passage itself, the debt catches up to you before you can outrun it. The Gray Wren is seized at the dock, her crew scattered to work off what they owe in Saltmere's grim counting-houses. The Hollow Passage keeps its record intact.",
      "art": "art-the-route-that-doesnt-come-back-ending-debtors-prison-art",
      "options": [],
      "improvBudget": 6,
      "entryWhen": {
