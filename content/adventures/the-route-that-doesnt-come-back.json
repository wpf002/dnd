    {
      "id": "heart-of-passage",
      "kind": "decision",
      "title": "The Heart of the Hollow Passage",
      "prose": "At the center of the passage, a mast-forest of wrecks surrounds a single intact flagship, lantern-lit from within by no living hand. Somewhere aboard, if the marks on the Widow's Bell meant anything, Mika might still be waiting.",
      "readAloud": "A voice like wet rope drifts across the water: \"Come aboard, then. The ledger's still open.\"",
      "art": "art-the-route-that-doesnt-come-back-heart-of-passage-art",
      "options": [
        {
          "id": "direct-assault",
          "label": "Lead the direct assault on the flagship",
          "visibleWhen": {
