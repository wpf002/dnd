{
  "id": "the-closing-dark",
  "schemaVersion": 1,
  "metadata": {
    "title": "The Closing Dark",
    "premise": "Beneath a sky that never held a sun, a chain of failing beacons is all that keeps a buried land livable, and the one door back to the surface seals itself a little tighter every hour you remain.",
    "tone": [
      "survival-horror",
      "exploration"
    ],
    "tier": "local",
    "partyLevel": 5,
    "narrationVoice": "Grim, economical, second person, with emphasis on dwindling light and the sound of stone grinding shut.",
    "contentLimits": {
      "exclude": [
        "harm to children depicted on-screen"
      ],
      "note": "No children appear on-screen in this scenario."
    },
    "provenance": "flint"
  },
  "entry": "threshold-gate",
  "beats": [
    {
      "id": "threshold-gate",
      "kind": "threshold",
      "title": "The Sealing Gate",
      "prose": "A slab of black basalt grinds inch by inch across the only known door into the Underlight, the failing land below. A gaunt gate-warden named Yssa Grae watches it with the weary patience of someone who has seen many parties go in and fewer come out.",
      "readAloud": "The gate groans as it settles another finger's width shut. Somewhere below, a beacon flickers and nearly dies, and the dark surges to fill the gap.",
      "art": "art-the-closing-dark-threshold-gate-art",
      "options": [
        {
          "id": "enter-causeway",
          "label": "Follow the beacon-line into the dark before it fades entirely",
          "visibleWhen": {
            "op": "always"
          },
          "target": "beacon-causeway",
          "effects": []
        },
        {
          "id": "search-gatehouse",
          "label": "Search the gatehouse for a faster route down",
          "visibleWhen": {
            "op": "always"
          },
          "target": "gatehouse-search",
          "effects": []
        },
        {
          "id": "parley-warden",
          "label": "Question the gate-warden about the closing way",
          "visibleWhen": {
            "op": "always"
          },
          "target": "warden-parley",
          "effects": []
        }
      ],
      "improvBudget": 7,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": false
    },
    {
      "id": "gatehouse-search",
      "kind": "discovery",
      "title": "The Warden's Archive",
      "prose": "Shelves of cracked ledgers and rolled charts line the gatehouse walls. A half-burned map fragment shows a shortcut through the old beacon causeway, if it can be trusted.",
      "readAloud": "Dust rises as you disturb decades of records. One chart, scorched at the edges, marks a path the others do not.",
      "art": "art-the-closing-dark-gatehouse-search-art",
      "options": [
        {
          "id": "take-map",
          "label": "Take the map fragment and hurry to the causeway",
          "visibleWhen": {
            "op": "always"
          },
          "target": "beacon-causeway",
          "effects": [
            {
              "flag": "has-map",
              "value": true
            }
          ]
        },
        {
          "id": "search-supplies",
          "label": "Search deeper for supplies before moving on",
          "visibleWhen": {
            "op": "always"
          },
          "target": "supply-cache",
          "effects": []
        },
        {
          "id": "go-warden",
          "label": "Bring your findings to the warden",
          "visibleWhen": {
            "op": "always"
          },
          "target": "warden-parley",
          "effects": []
        }
      ],
      "improvBudget": 6,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": false
    },
    {
      "id": "warden-parley",
      "kind": "social",
      "title": "Yssa Grae's Warning",
      "prose": "Yssa Grae's voice is flat with exhaustion. 'The way closes on its own hour. I can't stop it, and I won't lie about that. But I can trade you what I know for a favor owed.'",
      "readAloud": "'Every hour it seals a little more,' she says, not looking up from the mechanism she's tending. 'Ask your questions quickly.'",
      "art": "art-the-closing-dark-warden-parley-art",
      "options": [
        {
          "id": "trade-favor",
          "label": "Trade a favor for shortcut knowledge",
          "visibleWhen": {
            "op": "always"
          },
          "target": "beacon-causeway",
          "effects": [
            {
              "flag": "knows-shortcut",
              "value": true
            }
          ]
        },
        {
          "id": "refuse-press",
          "label": "Refuse and press onward alone",
          "visibleWhen": {
            "op": "always"
          },
          "target": "beacon-causeway",
          "effects": []
        },
        {
          "id": "ask-supplies",
          "label": "Ask where supplies might be cached nearby",
          "visibleWhen": {
            "op": "or",
            "clauses": [
              {
                "op": "always"
              },
              {
                "op": "eq",
                "flag": "has-map",
                "value": true
              }
            ]
          },
          "target": "supply-cache",
          "effects": []
        }
      ],
      "improvBudget": 7,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": false
    },
    {
      "id": "supply-cache",
      "kind": "discovery",
      "title": "The Forgotten Stores",
      "prose": "Behind a collapsed shelf, a cache of oil, rope, and rations sits undisturbed. Something has been gnawing at the crates from below the floorboards.",
      "readAloud": "The scratching stops the moment you step inside, as if whatever made it is listening back.",
      "art": "art-the-closing-dark-supply-cache-art",
      "options": [
        {
          "id": "grab-supplies",
          "label": "Grab what supplies remain and move on",
          "visibleWhen": {
            "op": "always"
          },
          "target": "beacon-causeway",
          "effects": [
            {
              "flag": "has-supplies",
              "value": true
            }
          ]
        },
        {
          "id": "investigate-scratching",
          "label": "Investigate the scratching beneath the floor",
          "visibleWhen": {
            "op": "always"
          },
          "target": "rat-nest-encounter",
          "effects": []
        },
        {
          "id": "return-warden",
          "label": "Return to ask the warden more before continuing",
          "visibleWhen": {
            "op": "always"
          },
          "target": "warden-parley",
          "effects": []
        }
      ],
      "improvBudget": 6,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": false
    },
    {
      "id": "beacon-causeway",
      "kind": "transit",
      "title": "The Guttering Causeway",
      "prose": "A stone bridge stretches over a black chasm, lit only by beacon-cages that flicker like dying hearts. Some have already gone dark. Shapes seem to gather where the light is thinnest.",
      "readAloud": "Halfway across, a beacon-cage sputters and dies. For a moment, the dark on the bridge is total, and something in it moves.",
      "art": "art-the-closing-dark-beacon-causeway-art",
      "options": [
        {
          "id": "cross-beacon",
          "label": "Press on toward the failing beacon tower",
          "visibleWhen": {
            "op": "always"
          },
          "target": "beacon-repair",
          "effects": []
        },
        {
          "id": "descend-shrine",
          "label": "Descend into the sunken shrine beneath the bridge",
          "visibleWhen": {
            "op": "always"
          },
          "target": "sunken-shrine",
          "effects": []
        },
        {
          "id": "shortcut-bypass",
          "label": "Cut through the shortcut, bypassing the bridge's watchers",
          "visibleWhen": {
            "op": "eq",
            "flag": "knows-shortcut",
            "value": true
          },
          "target": "beacon-repair",
          "effects": []
        }
      ],
      "improvBudget": 8,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": false
    },
    {
      "id": "sunken-shrine",
      "kind": "puzzle",
      "title": "The Drowned Shrine",
      "prose": "Below the causeway lies a half-flooded shrine to whatever kept the first beacons burning. Ritual markings describe a key of light that can be coaxed from the old stones, if read correctly.",
      "readAloud": "Water drips from a ceiling carved with spiraling flame-glyphs. In the deepest pool, something pale and patient waits beneath the surface.",
      "art": "art-the-closing-dark-sunken-shrine-art",
      "options": [
        {
          "id": "decipher-ritual",
          "label": "Decipher the beacon-key ritual carefully",
          "visibleWhen": {
            "op": "always"
          },
          "target": "beacon-repair",
          "effects": [
            {
              "flag": "has-beacon-key",
              "value": true
            }
          ]
        },
        {
          "id": "loot-hastily",
          "label": "Loot the shrine hastily, disturbing what sleeps",
          "visibleWhen": {
            "op": "always"
          },
          "target": "shadow-ambush",
          "effects": []
        },
        {
          "id": "retreat-causeway",
          "label": "Retreat to the causeway, empty-handed",
          "visibleWhen": {
            "op": "always"
          },
          "target": "beacon-causeway",
          "effects": []
        }
      ],
      "improvBudget": 7,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": false
    },
    {
      "id": "rat-nest-encounter",
      "kind": "conflict",
      "title": "Nest in the Walls",
      "prose": "Dozens of red eyes catch the last of the light as a swarm of oversized rats pours from the cracks in the stone.",
      "art": "art-the-closing-dark-rat-nest-encounter-art",
      "options": [],
      "improvBudget": 6,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "encounter": "rat-nest",
      "terminal": false
    },
    {
      "id": "shadow-ambush",
      "kind": "conflict",
      "title": "What the Dark Kept",
      "prose": "The shrine's shadows peel away from the walls, hungry for warmth and years long denied it.",
      "art": "art-the-closing-dark-shadow-ambush-art",
      "options": [],
      "improvBudget": 6,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "encounter": "shadow-ambush",
      "terminal": false
    },
    {
      "id": "beacon-repair",
      "kind": "puzzle",
      "title": "The Failing Tower",
      "prose": "The beacon tower's mechanism groans, its light reduced to a dying coal. Hobgoblin sentries who serve some older, colder master guard the controls.",
      "readAloud": "The tower's heartlight flickers once, twice, and dims further. Whatever tends it now is not friendly to strangers.",
      "art": "art-the-closing-dark-beacon-repair-art",
      "options": [
        {
          "id": "use-key",
          "label": "Use the beacon-key to relight the tower",
          "visibleWhen": {
            "op": "eq",
            "flag": "has-beacon-key",
            "value": true
          },
          "target": "final-ascent",
          "effects": []
        },
        {
          "id": "force-mechanism",
          "label": "Force the mechanism with brute strength",
          "visibleWhen": {
            "op": "always"
          },
          "target": "hobgoblin-guard",
          "effects": []
        },
        {
          "id": "flee-collapse",
          "label": "Abandon the repair and flee before the way fully seals",
          "visibleWhen": {
            "op": "always"
          },
          "target": "desperate-flight",
          "effects": []
        }
      ],
      "improvBudget": 8,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": false
    },
    {
      "id": "hobgoblin-guard",
      "kind": "conflict",
      "title": "The Tower's Wardens",
      "prose": "Hobgoblin sentries and their loping wolves bar the way to the beacon controls, disciplined and unwilling to yield ground.",
      "art": "art-the-closing-dark-hobgoblin-guard-art",
      "options": [],
      "improvBudget": 6,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "encounter": "hobgoblin-guard",
      "terminal": false
    },
    {
      "id": "desperate-flight",
      "kind": "hazard",
      "title": "The Last Hour",
      "prose": "Behind you, the gate has nearly closed. Ahead, the tunnels themselves seem to be narrowing, stone easing shut like a fist.",
      "readAloud": "Dust rains from the ceiling in sheets now. The walls are closer than they were a moment ago. You do not have long.",
      "art": "art-the-closing-dark-desperate-flight-art",
      "options": [
        {
          "id": "sprint-light",
          "label": "Sprint for the last light through the narrowing tunnels",
          "visibleWhen": {
            "op": "always"
          },
          "target": "final-ascent",
          "effects": [],
          "requiresCheck": {
            "ability": "dex",
            "skill": "acrobatics",
            "dc": 15,
            "onFailure": "the-way-seals"
          }
        },
        {
          "id": "use-shortcut",
          "label": "Use the shortcut you learned from the warden",
          "visibleWhen": {
            "op": "eq",
            "flag": "knows-shortcut",
            "value": true
          },
          "target": "final-ascent",
          "effects": []
        },
        {
          "id": "hold-line",
          "label": "Stand and hold the line so others may still pass",
          "visibleWhen": {
            "op": "always"
          },
          "target": "ending-lightkeeper",
          "effects": []
        }
      ],
      "improvBudget": 6,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": false
    },
    {
      "id": "final-ascent",
      "kind": "decision",
      "title": "The Choice at the Threshold",
      "prose": "The beacon-light steadies, however briefly. The way home is open again, for now. What you do with this reprieve will decide how this land remembers you, if it remembers at all.",
      "readAloud": "For the first time since you entered, the dark holds still, waiting on your decision.",
      "art": "art-the-closing-dark-final-ascent-art",
      "options": [
        {
          "id": "climb-surface",
          "label": "Climb toward the surface beacon-network and leave this place behind",
          "visibleWhen": {
            "op": "or",
            "clauses": [
              {
                "op": "always"
              },
              {
                "op": "eq",
                "flag": "has-supplies",
                "value": true
              }
            ]
          },
          "target": "ending-new-dawn",
          "effects": []
        },
        {
          "id": "stay-guard",
          "label": "Stay to guard the gate so it never fully closes again",
          "visibleWhen": {
            "op": "always"
          },
          "target": "ending-lightkeeper",
          "effects": []
        },
        {
          "id": "sever-way",
          "label": "Seal the way behind you forever, for everyone's safety",
          "visibleWhen": {
            "op": "always"
          },
          "target": "ending-severance",
          "effects": []
        }
      ],
      "improvBudget": 7,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": false
    },
    {
      "id": "ending-new-dawn",
      "kind": "ending",
      "title": "A Grey and Grudging Light",
      "prose": "You climb back into a sky that has no sun but is, at least, not sealed shut. The Underlight remains below, beacons guttering, waiting for someone else to find it.",
      "art": "art-the-closing-dark-ending-new-dawn-art",
      "options": [],
      "improvBudget": 5,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": true
    },
    {
      "id": "ending-lightkeeper",
      "kind": "ending",
      "title": "The New Warden",
      "prose": "You take up a post beside the gate, tending what light remains so that others might one day pass through safely. It is a lonely vigil, but not an unworthy one.",
      "art": "art-the-closing-dark-ending-lightkeeper-art",
      "options": [],
      "improvBudget": 5,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": true
    },
    {
      "id": "ending-severance",
      "kind": "ending",
      "title": "The Door Unmade",
      "prose": "You bring the way down behind you in a roar of collapsing stone. Whatever waited in the Underlight will wait forever now, and no one else will ever have to face it.",
      "art": "art-the-closing-dark-ending-severance-art",
      "options": [],
      "improvBudget": 5,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": true
    },
    {
      "id": "the-way-seals",
      "kind": "ending",
      "title": "Swallowed by the Dark",
      "prose": "The last beacon dies. The gate finishes its long, grinding closure with you still on the wrong side of it. The Underlight keeps what it takes.",
      "art": "art-the-closing-dark-the-way-seals-art",
      "options": [],
      "improvBudget": 5,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": true
    }
