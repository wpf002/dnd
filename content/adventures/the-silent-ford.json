      "improvBudget": 7,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": false
    },
    {
      "id": "barrow-wight",
      "kind": "conflict",
      "title": "The Barrow Wight's Guard",
      "prose": "Past the ferry landing, a sunken barrow guards the river's true crossing. A wight rises from the silt, zombies shambling at its call.",
      "art": "art-the-silent-ford-barrow-wight-guardian",
      "options": [],
      "improvBudget": 6,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "encounter": "barrow-wight",
      "terminal": false
    },
    {
      "id": "confrontation",
      "kind": "climax",
      "title": "The Cult of the Deep Toll",
      "prose": "Beyond the barrow, a hidden shrine-hall opens onto the truth: a cult has been diverting caravans into flooded tunnels beneath the river, feeding them to something that answers only to 'the deep toll.' The cult leader waits, unsurprised by your arrival.",
      "art": "art-the-silent-ford-cult-leader-confrontation",
      "options": [
        {
          "id": "expose-shrine",
          "label": "Destroy the shrine and expose the cult's toll",
          "visibleWhen": {
            "op": "eq",
            "flag": "found-cult-clue",
            "value": true
          },
          "target": "ending-route-reopened",
          "effects": []
        },
        {
          "id": "bargain-cult",
          "label": "Strike a bargain to keep the deep toll flowing quietly",
          "visibleWhen": {
            "op": "or",
            "clauses": [
              {
                "op": "eq",
                "flag": "paid-ferryman",
                "value": true
              },
              {
                "op": "eq",
                "flag": "helped-ferryman",
                "value": true
              }
            ]
          },
          "target": "ending-deep-bargain",
          "effects": []
        },
        {
          "id": "retreat-fail",
          "label": "Retreat and report failure to the League",
          "visibleWhen": {
            "op": "always"
          },
          "target": "ending-league-fractured",
          "effects": []
        }
      ],
      "improvBudget": 8,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": false
    },
    {
      "id": "ending-route-reopened",
      "kind": "ending",
      "title": "The Route Reopened",
      "prose": "With the shrine broken and the cult scattered, the Ferry Road reopens under League guard. Wagons roll again, and your names are carved beside the old toll-stone as a warning to anything still listening beneath the water.",
      "art": "art-the-silent-ford-ending-route-reopened-art",
      "options": [],
      "improvBudget": 6,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": true
    },
    {
      "id": "ending-deep-bargain",
      "kind": "ending",
      "title": "The Deep Bargain",
      "prose": "The road reopens, wagons rolling smoothly past the barrow once more. Only you know the price paid to keep it so, and only you hear, some nights, the toll being collected downriver.",
      "art": "art-the-silent-ford-ending-deep-bargain-art",
      "options": [],
      "improvBudget": 6,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": true
    },
    {
      "id": "ending-league-fractured",
      "kind": "ending",
      "title": "The League Fractured",
      "prose": "You return with no answers and fewer allies. Millhaven and Carrow's Landing sever the old road entirely, trade routes fracturing around the valley for a generation, and the toll-stone keeps its silence.",
      "art": "art-the-silent-ford-ending-league-fractured-art",
      "options": [],
      "improvBudget": 6,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": true
    }
