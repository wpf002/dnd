    {
      "id": "ending-sealed-silence",
      "kind": "ending",
      "title": "Ending: Sealed Silence",
      "prose": "The lever grinds home. The Bloomheart's light dims to embers and then to nothing. Vharesk will never wake again, and neither will its dead — but the poison recedes, and somewhere beyond the walls, the living exhale for the first time in years.",
      "art": "art-the-last-hour-of-vharesk-ending-sealed-silence",
      "options": [],
      "improvBudget": 6,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": true
    },
    {
      "id": "ending-transformed-covenant",
      "kind": "ending",
      "title": "Ending: The Transformed Covenant",
      "prose": "The Key turns not to silence but to communion. The Bloomheart shudders, folds inward, and becomes something smaller, stranger, and almost gentle — a covenant instead of a hunger, bound to whoever stands here when it wakes. Vharesk will grow again, changed, under new and watchful roots.",
      "art": "art-the-last-hour-of-vharesk-ending-transformed-covenant",
      "options": [],
      "improvBudget": 6,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": true
    },
    {
      "id": "ending-consumed-city",
      "kind": "ending",
      "title": "Ending: The Consumed City",
      "prose": "The Bloomheart finishes its final beat before the lever is ever reached. Vharesk folds inward on itself, its ruins swallowed into a hunger with no name. Somewhere far away, the sky over the world briefly turns the color of old bruises, and then it is over.",
      "art": "art-the-last-hour-of-vharesk-ending-consumed-city",
      "options": [],
      "improvBudget": 6,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": true
    },
    {
      "id": "ending-burned-legacy",
      "kind": "ending",
      "title": "Ending: The Burned Legacy",
      "prose": "One of you steps into the Heart's core and becomes the fire that unmakes it. The Bloomheart screams once, a sound like a city dying twice, and is gone. Vharesk is ash and silence now, but it is only ash — and the survivors will tell your name for as long as anyone remembers to speak of Vharesk at all.",
      "art": "art-the-last-hour-of-vharesk-ending-burned-legacy",
      "options": [],
      "improvBudget": 6,
      "entryWhen": {
        "op": "always"
      },
