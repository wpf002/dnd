{
  "id": "the-last-hour-of-vharesk",
  "schemaVersion": 1,
  "metadata": {
    "title": "The Last Hour of Vharesk",
    "premise": "In the poisoned heart of the fallen capital Vharesk, a god-organ called the Bloomheart is hours from hatching a hunger that will unmake the world. One mechanism remains that might stop it — the Last Choir Key — and the party has until the toxic tide reaches the palace to decide its fate.",
    "tone": [
      "epic-finale",
      "cosmic-horror"
    ],
    "tier": "national",
    "partyLevel": 8,
    "narrationVoice": "A grim, elegiac second-person narrator who speaks as if recording the last testimony of a dying city.",
    "contentLimits": {
      "exclude": [
        "harm to children depicted on-screen"
      ],
      "note": "No children appear on-screen; any references to the young of Vharesk remain off-page and are only spoken of in memory."
    },
    "provenance": "flint"
  },
  "entry": "shattered-gate",
