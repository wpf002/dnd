      "onExit": [],
      "terminal": false
    },
    {
      "id": "crossroads-choice",
      "kind": "decision",
      "title": "Three Roads to the Crater",
      "prose": "Beyond the office, the city splits into ruin. The Undercroft tunnels run beneath the rubble, Ashbound territory wraps the crater's edge, and the collapsing surface streets offer a desperate shortcut.",
      "art": "art-the-weight-of-ash-crossroads-choice-art",
      "options": [
        {
          "id": "undercroft-route",
          "label": "Descend into the Undercroft tunnels",
          "visibleWhen": {
            "op": "always"
          },
          "target": "undercroft-tunnels",
          "effects": []
        },
        {
          "id": "cult-route",
          "label": "Approach through Ashbound territory to negotiate passage",
          "visibleWhen": {
            "op": "always"
          },
          "target": "ashbound-parley",
          "effects": []
        },
        {
          "id": "direct-route",
