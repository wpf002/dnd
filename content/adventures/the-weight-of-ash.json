{
  "id": "the-weight-of-ash",
  "schemaVersion": 1,
  "metadata": {
    "title": "The Weight of Ash",
    "premise": "A stone fell from the sky and cracked the city of Greyhollow open. Now the quarantine wall seals a little tighter every hour, and the only way out is through whatever answered the stone's call.",
    "tone": [
      "survival-horror",
      "urban-intrigue"
    ],
    "tier": "local",
    "partyLevel": 4,
    "narrationVoice": "A grim, second-person present-tense narrator who lingers on decay and dwindling time.",
    "contentLimits": {
      "exclude": [
        "harm to children depicted on-screen"
      ],
      "note": "No child characters are placed in on-screen danger."
    },
    "provenance": "flint"
  },
  "entry": "quarantine-line",
  "beats": [
    {
      "id": "quarantine-line",
      "kind": "threshold",
      "title": "The Quarantine Line",
      "prose": "Ash sifts down like grey snow over the checkpoint where Greyhollow's last open gate groans on failing hinges. Soldiers with cloth-wrapped faces turn away anyone without papers. A wounded refugee slumps against the barricade, unnoticed.",
      "readAloud": "The gate will not stay open. Word is it closes a little more each hour, swallowed by whatever fell from the sky.",
      "art": "art-the-weight-of-ash-quarantine-line-art",
      "options": [
        {
          "id": "aid-refugee",
          "label": "Help the wounded refugee at the barricade",
          "visibleWhen": {
            "op": "always"
          },
          "target": "ashfall-market",
          "effects": [
            {
              "flag": "helped-refugee",
              "value": true
            }
          ]
        },
        {
          "id": "bribe-checkpoint",
          "label": "Bribe the checkpoint guard with scavenged coin",
          "visibleWhen": {
            "op": "always"
          },
          "target": "ashfall-market",
          "effects": []
        },
        {
          "id": "sneak-sewer",
          "label": "Slip through the flooded sewer grate",
          "visibleWhen": {
            "op": "always"
          },
          "target": "ashfall-market",
          "effects": [],
          "requiresCheck": {
            "ability": "dex",
            "skill": "stealth",
            "dc": 13,
            "onFailure": "ashfall-market"
          }
        }
      ],
      "improvBudget": 7,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": false
    },
    {
      "id": "ashfall-market",
      "kind": "discovery",
      "title": "The Ashfall Market",
      "prose": "Beneath a sagging tarp roof, survivors trade rations and rumors. Someone whispers that Warden Iris Calloway, keeper of the last working seal-gate, hasn't been herself since the stone fell. Others speak of the Ashbound, a cult that treats the crater as a shrine.",
      "art": "art-the-weight-of-ash-ashfall-market-art",
      "options": [
        {
          "id": "gather-rumors",
          "label": "Question the vendors about the crater",
          "visibleWhen": {
            "op": "always"
          },
          "target": "wardens-office",
          "effects": []
        },
        {
          "id": "investigate-corruption",
          "label": "Chase the whispers that the Warden is compromised",
          "visibleWhen": {
            "op": "always"
          },
          "target": "wardens-office",
          "effects": [
            {
              "flag": "exposed-corruption",
              "value": true
            }
          ]
        },
        {
          "id": "seek-cult-contact",
          "label": "Seek out an Ashbound trader rumored to know a back route",
          "visibleWhen": {
            "op": "always"
          },
          "target": "ashbound-parley",
          "effects": []
        }
      ],
      "improvBudget": 7,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": false
    },
    {
      "id": "wardens-office",
      "kind": "social",
      "title": "The Warden's Office",
      "prose": "Warden Iris Calloway sits behind a desk stacked with sealed reports, her eyes rimmed with grey dust that isn't quite ash. She speaks of the gate's closing measurements like a wound she can't stop describing.",
      "art": "art-the-weight-of-ash-wardens-office-art",
      "options": [
        {
          "id": "request-alliance",
          "label": "Request the Warden's aid in reaching the crater",
          "visibleWhen": {
            "op": "always"
          },
          "target": "crossroads-choice",
          "effects": [
            {
              "flag": "warden-trusts-player",
              "value": true
            }
          ]
        },
        {
          "id": "confront-corruption",
          "label": "Confront her about the corruption rumors",
          "visibleWhen": {
            "op": "eq",
            "flag": "exposed-corruption",
            "value": true
          },
          "target": "crossroads-choice",
          "effects": [
            {
              "flag": "warden-trusts-player",
              "value": false
            }
          ]
        },
        {
          "id": "bargain-refugee",
          "label": "Remind her of the refugee you saved to earn favor",
          "visibleWhen": {
            "op": "eq",
            "flag": "helped-refugee",
            "value": true
          },
          "target": "crossroads-choice",
          "effects": [
            {
              "flag": "warden-trusts-player",
              "value": true
            }
