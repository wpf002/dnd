    {
      "id": "final-choice",
      "kind": "decision",
      "title": "The Last Hour",
      "prose": "The gate groans, nearly shut. Whatever you carry, whatever you know, this is the moment it matters.",
      "art": "art-the-weight-of-ash-final-choice-art",
      "options": [
        {
          "id": "flee-with-shard",
          "label": "Flee through the gate with the shard in hand",
          "visibleWhen": {
            "op": "eq",
            "flag": "have-shard",
            "value": true
          },
          "target": "ending-escape-shard",
          "effects": []
        },
        {
          "id": "seal-gate-sacrifice",
          "label": "Stay behind to seal the gate and end the quarantine's spread",
          "visibleWhen": {
            "op": "always"
          },
          "target": "ending-seal-sacrifice",
          "effects": []
        },
        {
          "id": "expose-warden",
          "label": "Drag the truth of the Warden's corruption into the light",
          "visibleWhen": {
            "op": "eq",
