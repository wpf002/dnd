    },
    {
      "id": "ending-escape-shard",
      "kind": "ending",
      "title": "Out of the Ash",
      "prose": "You clear the gate as it grinds shut behind you, the shard's weight cold against your ribs. Greyhollow is still sealed, still suffering, but you carry a piece of what struck it — and perhaps an answer to why.",
      "art": "art-the-weight-of-ash-ending-escape-shard-art",
      "options": [],
      "improvBudget": 6,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": true
    },
    {
      "id": "ending-seal-sacrifice",
      "kind": "ending",
      "title": "The Gate Holds",
      "prose": "You brace the mechanism with everything you have as the last light of the outside world narrows to a seam, then nothing. The gate holds. Whether you hold with it is a story only the quiet city will tell.",
      "art": "art-the-weight-of-ash-ending-seal-sacrifice-art",
      "options": [],
      "improvBudget": 6,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": true
    },
    {
      "id": "ending-expose-corruption",
      "kind": "ending",
      "title": "The Warden Unmasked",
      "prose": "You drag Iris Calloway's corruption into the market square's ashen light. The survivors riot, then rebuild under new leadership. The stone remains buried, but Greyhollow finally knows what it has been protecting.",
      "art": "art-the-weight-of-ash-ending-expose-corruption-art",
      "options": [],
      "improvBudget": 6,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": true
    },
    {
      "id": "ending-trapped-below",
      "kind": "ending",
      "title": "Swallowed by the Quarantine",
      "prose": "The last measurement of the gate reads zero. Somewhere above, Greyhollow seals itself against the world, and you are left among the ash and the things that made it their home.",
      "art": "art-the-weight-of-ash-ending-trapped-below-art",
      "options": [],
      "improvBudget": 6,
