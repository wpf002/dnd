  "metadata": {
    "title": "The Ashfen Wager",
    "premise": "In a grey purgatorial waste ruled by a fractured Card Court, the only way out is a Last Door that seals a little more with every passing hour, and the four Suit-Wardens will each demand their price before it shuts for good.",
    "tone": [
      "survival-horror",
      "gothic-horror"
    ],
    "tier": "local",
    "partyLevel": 5,
    "narrationVoice": "A patient, whispering second-person narrator who counts the hours aloud",
    "contentLimits": {
      "exclude": [
        "harm to children depicted on-screen"
      ],
      "note": "No children appear in this scenario."
    },
    "provenance": "flint"
  },
  "entry": "arrival-at-the-ashfen",
