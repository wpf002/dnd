    {
      "id": "tide-village-arrival",
      "kind": "discovery",
      "title": "Bellhaven at Low Tide",
      "prose": "The village rises from the wet sand as the tide recedes — rope bridges, driftwood roofs, and windows shuttered against the returning sea.",
      "art": "art-the-tideglass-bell-village-at-low-tide",
      "options": [
        {
          "id": "seek-warden",
          "label": "Seek out the village warden immediately",
          "target": "warden-meeting",
          "effects": []
        },
        {
          "id": "explore-flats",
          "label": "Explore the tide-flats before the water returns",
          "target": "warden-meeting",
          "effects": [
            {
              "flag": "found-clue",
              "value": true
            }
          ],
          "requiresCheck": {
            "ability": "wis",
            "skill": "perception",
            "dc": 12,
            "onFailure": "warden-meeting"
          }
        },
        {
          "id": "mira-shortcut",
          "label": "Let Mira guide you through a hidden shortcut to the bell chamber",
          "visibleWhen": {
            "op": "eq",
            "flag": "companion-mira",
            "value": true
          },
          "target": "bell-chamber",
          "effects": []
        }
      ],
      "improvBudget": 7,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": false
    },
    {
