      "encounter": "ghost-keeper",
      "terminal": false
    },
    {
      "id": "free-the-spirit",
      "kind": "discovery",
      "title": "The Tide-Spirit Freed",
      "prose": "The bell cracks open like an egg, and a shape of moving water and starlight rises, blinking as if waking from a long sleep.",
      "art": "art-the-tideglass-bell-the-tide-spirit-freed",
      "options": [
        {
          "id": "ask-why",
          "label": "Ask the spirit why it was ever imprisoned",
          "target": "the-truth-revealed",
          "effects": []
        },
        {
          "id": "let-it-go",
          "label": "Simply thank it and let it depart",
          "target": "ending-tide-freed",
          "effects": []
        },
        {
          "id": "stay-with-it",
          "label": "Offer to stay and help it find its place again",
          "target": "ending-new-guardian",
          "effects": []
        }
      ],
      "improvBudget": 7,
      "entryWhen": {
        "op": "eq",
        "flag": "freed-spirit",
        "value": true
      },
      "onEntry": [],
      "onExit": [],
      "terminal": false
    },
    {
      "id": "the-truth-revealed",
      "kind": "decision",
      "title": "The Spirit's Tale",
      "prose": "The spirit says Old Cael's family bound it generations ago to steady the tides for profit — and Cael means to bind it again.",
      "art": "art-the-tideglass-bell-the-spirits-tale",
      "options": [
        {
          "id": "confront-cael",
          "label": "Return at once to confront Old Cael",
          "target": "ending-confront-cael",
          "effects": []
        },
        {
          "id": "call-warden",
          "label": "Send word to Warden Thess, who already stands with you",
          "visibleWhen": {
            "op": "eq",
            "flag": "warden-ally",
            "value": true
          },
          "target": "ending-new-guardian",
          "effects": []
        },
        {
          "id": "become-guardian",
          "label": "Choose to become the tide's guardian yourself",
          "target": "ending-tide-freed",
          "effects": []
        }
      ],
      "improvBudget": 7,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": false
    },
    {
      "id": "ending-confront-cael",
      "kind": "ending",
      "title": "The Reckoning",
      "prose": "You find Old Cael waiting, unsurprised, as if he always knew the bell would answer someone honest enough to ask. Whatever comes next, the truth is loose in the world now — and so is the tide.",
      "art": "art-the-tideglass-bell-ending-confrontation",
      "options": [],
      "improvBudget": 7,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": true
    },
    {
      "id": "ending-new-guardian",
      "kind": "ending",
      "title": "Bellhaven's New Guardian",
      "prose": "The spirit settles into the village's old bell-tower, no longer a prisoner but a neighbor. Bellhaven will rise with the tide for a long, long time to come, and it will remember your names.",
      "art": "art-the-tideglass-bell-ending-village-guardian",
      "options": [],
      "improvBudget": 7,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": true
    },
    {
      "id": "ending-tide-freed",
      "kind": "ending",
      "title": "Out to Open Water",
      "prose": "The spirit dissolves into foam and starlight, free at last, and the sea itself seems to sigh in relief. You walk away lighter, the strange commission finally, fully finished.",
      "art": "art-the-tideglass-bell-ending-open-tide",
      "options": [],
      "improvBudget": 7,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": true
    },
    {
      "id": "ending-captured",
      "kind": "ending",
      "title": "Taken on the Road",
      "prose": "The ambushers overwhelm you before the bell ever reaches the sea. Whoever sent them now has both the bell and your names — and Bellhaven never learns what almost came for it.",
      "art": "art-the-tideglass-bell-ending-captured-courier",
      "options": [],
      "improvBudget": 7,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": true
    },
    {
      "id": "ending-lost-to-tide",
      "kind": "ending",
      "title": "Swallowed by the Cave",
      "prose": "The guardian proves too much. The cave floods with the returning tide, and Bellhaven wakes the next morning to a bell that never rang and visitors who never left.",
      "art": "art-the-tideglass-bell-ending-swallowed-cave",
      "options": [],
