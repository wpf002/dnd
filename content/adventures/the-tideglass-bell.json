    {
      "id": "bell-chamber",
      "kind": "puzzle",
      "title": "The Humming Bell",
      "prose": "In a sea-cave beneath the village, the bell hums louder with every step, as though it recognizes the place.",
      "art": "art-the-tideglass-bell-the-humming-bell",
      "options": [
        {
          "id": "ring-bell",
          "label": "Ring the bell as instructed",
          "target": "ghost-keeper",
          "effects": []
        },
        {
          "id": "examine-bell",
          "label": "Examine the bell for a way to free what's inside first",
          "target": "free-the-spirit",
          "effects": [
            {
              "flag": "freed-spirit",
              "value": true
            }
          ],
          "requiresCheck": {
            "ability": "int",
            "skill": "arcana",
            "dc": 14,
            "onFailure": "ghost-keeper"
          }
        },
        {
          "id": "use-preparations",
          "label": "Use what you found or prepared to unlatch it safely",
          "visibleWhen": {
            "op": "or",
            "clauses": [
              {
                "op": "eq",
                "flag": "found-clue",
                "value": true
              },
              {
