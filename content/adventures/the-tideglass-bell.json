      "terminal": false
    },
    {
      "id": "ghost-keeper",
      "kind": "conflict",
      "title": "The Cave Guardian Awakens",
      "prose": "The bell's toll wakes something bound to guard it — shifting shadows and rattling bones surge from the dark water.",
      "art": "art-the-tideglass-bell-shadows-in-the-cave",
      "options": [],
      "improvBudget": 6,
      "entryWhen": {
        "op": "always"
      },
