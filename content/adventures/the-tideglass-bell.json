    {
      "id": "river-crossing",
      "kind": "transit",
      "title": "The Wide River",
      "prose": "The road to Bellhaven crosses a broad, lazy river. A ferry waits at the crossing, but there are other ways over — and other risks.",
      "art": "art-the-tideglass-bell-the-wide-river",
      "options": [
        {
          "id": "take-ferry",
          "label": "Pay the toll and take the ferry",
          "target": "tide-village-arrival",
          "effects": []
        },
        {
          "id": "ford-river",
          "label": "Ford the river yourselves to save the coin",
          "target": "tide-village-arrival",
          "effects": [],
          "requiresCheck": {
            "ability": "str",
            "skill": "athletics",
            "dc": 12,
            "onFailure": "bandit-ambush"
          }
        },
        {
          "id": "smugglers-path",
          "label": "Follow rumors of an old smugglers' path",
          "target": "bandit-ambush",
          "effects": []
        }
