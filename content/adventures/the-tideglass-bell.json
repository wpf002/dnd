      "kind": "social",
      "title": "The Old Warden",
      "prose": "Warden Thess receives you in a driftwood hall hung with tide-charts older than the village itself.",
      "art": "art-the-tideglass-bell-the-old-warden",
      "options": [
        {
          "id": "show-letter",
          "label": "Show her the commission letter plainly",
          "target": "bell-chamber",
          "effects": []
        },
        {
