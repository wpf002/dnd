          },
          "target": "bell-chamber",
          "effects": [
            {
              "flag": "warden-ally",
              "value": true
            }
          ]
        },
        {
          "id": "offer-split",
          "label": "Offer to split any reward evenly with the village",
          "visibleWhen": {
