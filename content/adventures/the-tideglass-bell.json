{
  "id": "the-tideglass-bell",
  "schemaVersion": 1,
  "metadata": {
    "title": "The Tideglass Bell",
    "premise": "A patron with no discernible history hires the party to carry a strange, faintly humming bell to a village that only exists at low tide. The commission has no obvious connection to anything — until the bell starts answering back.",
    "tone": [
      "anthology",
      "exploration"
    ],
    "tier": "local",
    "partyLevel": 3,
    "narrationVoice": "Warm, curious, and a little wry — like a storyteller recounting one bright afternoon's strange errand among many.",
    "contentLimits": {
      "exclude": [
        "harm to children depicted on-screen"
      ],
      "note": "No violence toward or endangerment of children is depicted."
    },
    "provenance": "flint"
  },
  "entry": "strange-commission",
  "beats": [
    {
      "id": "strange-commission",
      "kind": "threshold",
      "title": "The Odd Commission",
      "prose": "A robed stranger called Old Cael offers you a locked, velvet-wrapped bell and a single instruction: carry it to Bellhaven, a village that appears only at low tide, and ring it once you arrive. The pay is generous. The reason is not given.",
      "readAloud": "\"Ask no questions of the sea,\" Cael says, pressing the bundle into your hands, \"and it will ask none of you.\"",
      "art": "art-the-tideglass-bell-the-commission-letter",
      "options": [
        {
          "id": "accept-plainly",
          "label": "Accept the commission without question",
          "target": "prepare-journey",
          "effects": []
        },
        {
          "id": "press-for-truth",
          "label": "Press Cael for the truth behind the bell",
          "target": "prepare-journey",
          "effects": [
            {
              "flag": "know-secret",
              "value": true
            }
          ],
          "requiresCheck": {
            "ability": "wis",
            "skill": "insight",
            "dc": 13,
            "onFailure": "bandit-ambush"
          }
        },
        {
          "id": "haggle-pay",
          "label": "Haggle for a higher fee before agreeing",
          "target": "prepare-journey",
          "effects": [
            {
              "flag": "greedy",
              "value": true
            }
          ]
        }
      ],
      "improvBudget": 7,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": false
    },
    {
      "id": "prepare-journey",
      "kind": "discovery",
      "title": "Market-Day Preparations",
      "prose": "Before the road, you have time to prepare in the bright, bustling market square, full of travelers bound for a dozen short journeys of their own.",
      "art": "art-the-tideglass-bell-market-day-prep",
      "options": [
        {
          "id": "recruit-mira",
          "label": "Recruit the itinerant cartographer Mira",
          "target": "river-crossing",
          "effects": [
            {
              "flag": "companion-mira",
              "value": true
            }
          ]
        },
        {
          "id": "buy-case",
          "label": "Buy a sturdy waterproof case for the bell",
          "target": "river-crossing",
          "effects": [
            {
