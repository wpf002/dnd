    {
      "id": "vanished-convoy",
      "kind": "discovery",
      "title": "The Vanished Convoy",
      "prose": "The envoy's wagon lies broken and looted, but the bodies are missing entirely, dragged off toward one of two territories bordering the road.",
      "readAloud": "No blood pools where the fighting happened. Whoever took them wanted them alive.",
      "art": "art-the-hollow-span-reckoning-wrecked-convoy",
      "options": [
        {
          "id": "study-wreckage",
          "label": "Study the wreckage for evidence of the attackers",
          "visibleWhen": {
            "op": "always"
          },
          "target": "diverging-paths",
          "effects": [
            {
              "flag": "has-evidence",
              "value": true
            }
          ]
        },
        {
          "id": "follow-kobold-tracks",
          "label": "Follow the drag-marks toward the warren tunnels",
          "visibleWhen": {
