          },
          "target": "diverging-paths",
          "effects": []
        },
        {
          "id": "follow-goblin-signs",
          "label": "Follow the broken banners toward the bramble thicket",
          "visibleWhen": {
            "op": "always"
          },
          "target": "diverging-paths",
          "effects": []
        }
