    {
      "id": "hidden-concord",
      "kind": "social",
      "title": "The Hidden Concord",
      "prose": "Beyond the gates lies a hollow valley where the Concord's elders keep the surviving envoy bound within warded stones, a hostage against the Compact's old betrayals.",
      "readAloud": "'Your Compact promised us the eastern vale and gave us ash instead,' the eldest says. 'Convince me you are different.'",
      "art": "art-the-hollow-span-reckoning-hidden-concord-hall",
      "options": [
        {
          "id": "present-evidence",
          "label": "Present the evidence and demand the envoy's release",
          "visibleWhen": {
            "op": "eq",
            "flag": "has-evidence",
            "value": true
          },
          "target": "binding-stones",
          "effects": [
            {
              "flag": "showed-evidence",
              "value": true
            }
          ]
        },
        {
          "id": "offer-treaty",
          "label": "Offer the Compact's treaty terms in good faith",
          "visibleWhen": {
            "op": "always"
          },
          "target": "binding-stones",
          "effects": []
        },
        {
          "id": "walk-away",
          "label": "Refuse further talk and turn back to the frontier",
          "visibleWhen": {
            "op": "always"
          },
          "target": "frontier-alone",
          "effects": []
        }
