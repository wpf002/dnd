    {
      "id": "reckoning-choice",
      "kind": "decision",
      "title": "The Reckoning Choice",
      "prose": "With the envoy free and the Concord watching, the moment has come to decide what the frontier's future will look like.",
      "readAloud": "The elders and the envoy both wait on your word. Whatever you say next will outlive this valley.",
      "art": "art-the-hollow-span-reckoning-reckoning-crossroads",
      "options": [
        {
          "id": "forge-treaty",
          "label": "Forge a lasting treaty between the frontier and the Concord",
          "visibleWhen": {
            "op": "or",
            "clauses": [
              {
                "op": "eq",
                "flag": "showed-evidence",
                "value": true
              },
              {
                "op": "eq",
                "flag": "ritual-solved",
                "value": true
              }
            ]
          },
          "target": "treaty-restored",
          "effects": []
        },
        {
          "id": "withdraw-quietly",
          "label": "Withdraw quietly, leaving the frontier to fend for itself",
          "visibleWhen": {
            "op": "always"
          },
          "target": "frontier-alone",
          "effects": []
        },
        {
          "id": "shatter-accord",
          "label": "Shatter the old accord and claim the road by force",
          "visibleWhen": {
            "op": "always"
          },
          "target": "broken-accord",
          "effects": []
        }
      ],
      "improvBudget": 8,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": false
    },
    {
      "id": "treaty-restored",
      "kind": "ending",
      "title": "Treaty Restored",
      "prose": "The envoy returns to the frontier alive, and with them a new treaty that finally names the road's tolls fairly. The Hollow Span becomes a route people walk again, not a warning.",
      "readAloud": "For the first time in a generation, a wagon crosses the Hollow Span and comes back the same day.",
      "art": "art-the-hollow-span-reckoning-treaty-signing-dawn",
      "options": [],
      "improvBudget": 6,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": true
    },
    {
      "id": "frontier-alone",
      "kind": "ending",
      "title": "The Frontier Alone",
      "prose": "You leave the valley without an accord. The frontier settlements brace for a colder, harder season, uncertain whether peace or war waits down the Hollow Span next.",
      "readAloud": "No treaty, no war—just a long, uneasy quiet stretching out over the reeds.",
      "art": "art-the-hollow-span-reckoning-frontier-retreat",
      "options": [],
      "improvBudget": 6,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": true
    },
    {
      "id": "broken-accord",
      "kind": "ending",
      "title": "The Broken Accord",
      "prose": "Blood is spilled where words might have served, and the Hollow Span becomes a battle line rather than a road. The frontier's peace dies here, replaced by a war neither side will soon end.",
      "readAloud": "Smoke rises from the valley behind you. Whatever comes next, it will not be peace.",
      "art": "art-the-hollow-span-reckoning-broken-accord-ruins",
      "options": [],
      "improvBudget": 6,
      "entryWhen": {
        "op": "always"
      },
