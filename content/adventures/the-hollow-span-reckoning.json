      },
      "onEntry": [],
      "onExit": [],
      "terminal": false
    },
    {
      "id": "shifting-span",
      "kind": "hazard",
      "title": "The Shifting Span",
      "prose": "A rope-and-plank bridge sways over a black chasm, warded stones humming faintly along its rails. Something below watches the crossing.",
      "readAloud": "The planks groan underfoot. Every third stone along the rail bears a sigil that was not carved by human hands.",
      "art": "art-the-hollow-span-reckoning-rope-bridge-mist",
      "options": [
        {
          "id": "careful-crossing",
          "label": "Cross carefully, testing each plank",
          "visibleWhen": {
            "op": "always"
          },
          "target": "vanished-convoy",
          "effects": [],
          "requiresCheck": {
            "ability": "dex",
            "skill": "acrobatics",
            "dc": 13,
            "onFailure": "narrows-ambush"
          }
        },
        {
          "id": "cut-across-guardian",
          "label": "Push past the warding sigils toward whatever guards the span",
          "visibleWhen": {
            "op": "always"
          },
          "target": "hollow-vigil",
          "effects": []
        },
        {
          "id": "retreat-to-camp",
          "label": "Fall back to the wayfarer camp to regroup",
          "visibleWhen": {
            "op": "always"
          },
          "target": "wayfarer-camp",
          "effects": []
        }
      ],
      "improvBudget": 7,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": false
