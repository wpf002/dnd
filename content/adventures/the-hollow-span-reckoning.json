    {
      "id": "diverging-paths",
      "kind": "decision",
      "title": "Two Paths Diverge",
      "prose": "The trail splits: one way leads down into the kobold warren's toll-gate, the other through a goblin-held bramble gate. Both border the hidden seat of the Concord.",
      "readAloud": "Two gates, two guardians, one road beyond them both.",
      "art": "art-the-hollow-span-reckoning-forked-trail",
      "options": [
        {
          "id": "enter-warren",
          "label": "Enter the kobold warren's toll-gate",
          "visibleWhen": {
            "op": "always"
          },
          "target": "warren-toll",
          "effects": []
        },
        {
          "id": "enter-bramble",
          "label": "Push through the goblin bramble gate",
          "visibleWhen": {
            "op": "always"
          },
          "target": "bramble-gate",
          "effects": []
        },
        {
          "id": "seek-concord-directly",
