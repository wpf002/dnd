{
  "id": "the-hollow-span-reckoning",
  "schemaVersion": 1,
  "metadata": {
    "title": "The Hollow Span Reckoning",
    "premise": "On the frontier world of Calder's Reach, the trade road called the Hollow Span has swallowed every envoy sent to renew the treaty with the Concord of the Deep Warrens, and without a new accord the frontier settlements will fall to open war within the season.",
    "tone": [
      "exploration",
      "political-fantasy"
    ],
    "tier": "regional",
    "partyLevel": 4,
    "narrationVoice": "A weathered frontier chronicler recounting the tale by lamplight, wry but respectful of the stakes.",
    "contentLimits": {
      "exclude": [
        "harm to children depicted on-screen"
      ],
      "note": "Keep violence focused on adult combatants and political stakes; no children endangered on-screen."
    },
    "provenance": "flint"
  },
  "entry": "call-to-cross",
  "beats": [
    {
      "id": "call-to-cross",
      "kind": "threshold",
      "title": "The Envoy's Charge",
      "prose": "The Aldergate Compact's council has one request: find out why the Hollow Span road has taken three envoys and returned none, and if possible, save the fourth before the treaty deadline lapses.",
      "readAloud": "Lantern-light gutters over the council table as the Warden-Speaker slides a worn map toward you. 'The road takes people now,' she says. 'We need someone who comes back.'",
      "art": "art-the-hollow-span-reckoning-frontier-outpost-dawn",
      "options": [
        {
          "id": "go-marsh-scout",
          "label": "Take the scout's causeway through the reed marsh",
          "visibleWhen": {
            "op": "always"
          },
          "target": "cairn-trailhead",
          "effects": []
        },
        {
          "id": "go-merchant-road",
          "label": "Ride the merchant road toward the wayfarer camp",
          "visibleWhen": {
            "op": "always"
          },
          "target": "wayfarer-camp",
          "effects": []
        },
        {
          "id": "go-bold-span",
          "label": "Push straight for the Hollow Span bridge itself",
          "visibleWhen": {
            "op": "always"
          },
          "target": "shifting-span",
          "effects": []
        }
      ],
      "improvBudget": 7,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": false
    },
    {
      "id": "cairn-trailhead",
      "kind": "discovery",
      "title": "The Trailhead Cairns",
      "prose": "Stone cairns mark the causeway, each stacked by a different hand for a different missing traveler. Wagon ruts veer off the path and vanish into reeds.",
      "readAloud": "Someone has been counting the lost. Four cairns. Four names scratched into river-stone.",
      "art": "art-the-hollow-span-reckoning-marsh-cairns",
      "options": [
        {
          "id": "continue-to-camp",
          "label": "Detour to the wayfarer camp for fresher news",
          "visibleWhen": {
            "op": "always"
          },
          "target": "wayfarer-camp",
          "effects": []
        },
        {
          "id": "push-to-narrows",
          "label": "Press on toward the narrows where the tracks vanish",
          "visibleWhen": {
            "op": "always"
          },
          "target": "narrows-ambush",
          "effects": []
        },
        {
          "id": "examine-cairns",
          "label": "Examine the cairns for clues to the convoy's fate",
          "visibleWhen": {
            "op": "always"
          },
          "target": "vanished-convoy",
          "effects": []
        }
      ],
      "improvBudget": 7,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": false
    },
    {
      "id": "wayfarer-camp",
      "kind": "social",
      "title": "The Wayfarer's Camp",
      "prose": "Refugees and traders huddle around cookfires, trading half-true rumors about the Concord's warrens and the road's hunger. Tempers fray between those who blame the Concord and those who blame the Compact.",
      "readAloud": "'The road doesn't take you,' an old muleteer mutters. 'Something down there decides who's worth keeping.'",
      "art": "art-the-hollow-span-reckoning-wayfarer-campfire",
      "options": [
        {
          "id": "trade-rumors",
          "label": "Trade rumors with the refugees about the road",
          "visibleWhen": {
            "op": "always"
          },
          "target": "cairn-trailhead",
          "effects": []
        },
        {
          "id": "press-onward-narrows",
          "label": "Press onward toward the narrows despite the warnings",
          "visibleWhen": {
            "op": "always"
          },
          "target": "narrows-ambush",
          "effects": []
        },
        {
          "id": "gather-testimony",
          "label": "Gather sworn testimony to use as evidence later",
          "visibleWhen": {
            "op": "always"
          },
          "target": "vanished-convoy",
          "effects": [
            {
              "flag": "has-evidence",
              "value": true
            }
          ]
        }
      ],
      "improvBudget": 8,
      "entryWhen": {
