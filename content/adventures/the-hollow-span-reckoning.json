    {
      "id": "binding-stones",
      "kind": "puzzle",
      "title": "The Binding Stones",
      "prose": "The envoy sits motionless behind a ring of warded stones, bound by old Concord magic that answers to neither key nor blade.",
      "readAloud": "The envoy's eyes track you, alive but frozen mid-breath, held by wards older than either your peoples' quarrels.",
      "art": "art-the-hollow-span-reckoning-binding-stone-circle",
      "options": [
        {
          "id": "unlock-wards",
          "label": "Study the warding sigils and attempt to unlock them",
