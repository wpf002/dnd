          "effects": [
            {
              "flag": "prep",
              "value": "plans"
            }
          ]
        },
        {
          "id": "scout-exit-route",
          "label": "Scout a clean route back out first",
          "visibleWhen": {
            "op": "always"
          },
          "target": "the-vault-room",
          "effects": [
            {
              "flag": "prep",
              "value": "exit"
            }
          ]
        },
        {
          "id": "head-straight-vault",
          "label": "Head straight for the vault, boldly",
          "visibleWhen": {
            "op": "always"
          },
          "target": "the-vault-room",
          "effects": [
            {
              "flag": "prep",
              "value": "bold"
