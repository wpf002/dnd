    {
      "id": "the-approach",
      "kind": "hazard",
      "title": "Into Tallow Hall",
      "prose": "The Widow's Vigil is in full, mournful swing. Candlelight and off-key dirges spill from the windows while the night watch — underpaid, overworked, and none too sharp — makes its rounds.",
      "art": "art-the-ashgrave-vault-hall-approach-art",
      "options": [
        {
          "id": "use-scouted-route",
          "label": "Use the route you scouted",
          "visibleWhen": {
            "op": "or",
            "clauses": [
              {
                "op": "eq",
                "flag": "scout-focus",
                "value": "sewers"
              },
              {
                "op": "eq",
                "flag": "scout-focus",
                "value": "masquerade"
              },
              {
                "op": "eq",
                "flag": "scout-focus",
                "value": "roof"
              }
            ]
          },
          "target": "inside-tallow-hall",
          "effects": []
        },
        {
          "id": "push-forward-blind",
