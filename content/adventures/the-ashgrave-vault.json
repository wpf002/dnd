{
  "id": "the-ashgrave-vault",
  "schemaVersion": 1,
  "metadata": {
    "title": "The Ashgrave Vault",
    "premise": "In the threadbare Duchy of Marrowfen, where even successful thieves barely eat, a crew is hired to steal the Mourning Seal from Tallow Hall during the one night its halls are full of drunken nobles — a building designed by a paranoid architect who built the place to betray thieves exactly like them.",
    "tone": [
      "heist",
      "urban-intrigue"
    ],
    "tier": "local",
    "partyLevel": 3,
    "narrationVoice": "Wry, world-weary noir narrator with dark humor about poverty, debt, and bad decisions",
    "contentLimits": {
      "exclude": [
        "harm to children depicted on-screen"
      ],
      "note": "Keep violence consequence-driven and non-graphic; no children in danger on-screen."
    },
    "provenance": "flint"
  },
  "entry": "smoky-offer",
  "beats": [
    {
      "id": "smoky-offer",
      "kind": "threshold",
      "title": "A Job in the Gutterlight",
      "prose": "The Gutterlight tavern smells of tallow smoke and cheap ale. Nessa Vell, fence and fixer to half the desperate thieves in Marrowfen, slides a folded scrap of paper across the table: a sketch of Tallow Hall and a single word underlined twice — TONIGHT. She wants the Duchess's Mourning Seal, the wax-and-iron thing that can forgive a duchy's worth of debt, lifted during the Widow's Vigil, when the hall is fullest and, she swears, the guards are drunkest.",
      "readAloud": "\"Everyone's poor in this duchy, love,\" Nessa says, \"except whoever's holding that seal. Tonight, that's us.\"",
      "art": "art-the-ashgrave-vault-smoky-offer-art",
      "options": [
        {
          "id": "take-the-coin",
          "label": "Take the coin and ask no questions",
          "visibleWhen": {
            "op": "always"
          },
          "target": "casing-the-hall",
          "effects": []
        },
        {
          "id": "ask-about-object",
          "label": "Ask what makes this seal worth the risk",
          "visibleWhen": {
            "op": "always"
          },
          "target": "casing-the-hall",
          "effects": []
        },
        {
          "id": "push-for-cut",
          "label": "Push for a bigger cut before agreeing",
          "visibleWhen": {
            "op": "always"
          },
          "target": "casing-the-hall",
          "effects": []
        }
      ],
      "improvBudget": 7,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": false
    },
    {
      "id": "casing-the-hall",
      "kind": "discovery",
      "title": "Casing Tallow Hall",
      "prose": "Tallow Hall looms over Backalley Row, all narrow windows and too-clever brickwork. It was designed decades ago by Master Corvin Ashgrave, a paranoid genius who reportedly built every trap he could think of into his own masterpiece — then got locked in an asylum for insisting thieves would come for it someday. He was right.",
      "art": "art-the-ashgrave-vault-casing-hall-art",
      "options": [
        {
          "id": "scout-sewers",
          "label": "Study the sewer grates beneath the hall",
          "visibleWhen": {
            "op": "always"
          },
          "target": "the-plan",
          "effects": [
            {
              "flag": "scout-focus",
              "value": "sewers"
            }
          ]
        },
        {
          "id": "scout-guestlist",
          "label": "Watch the Widow's Vigil guest list arrive",
          "visibleWhen": {
            "op": "always"
          },
          "target": "the-plan",
          "effects": [
            {
              "flag": "scout-focus",
              "value": "masquerade"
            }
          ]
        },
        {
          "id": "scout-roofline",
          "label": "Map the rooftops and gutters above",
          "visibleWhen": {
            "op": "always"
          },
          "target": "the-plan",
          "effects": [
            {
              "flag": "scout-focus",
              "value": "roof"
            }
          ]
        }
      ],
      "improvBudget": 7,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": false
    },
    {
      "id": "the-plan",
      "kind": "decision",
      "title": "Choosing the Crew",
      "prose": "Back at the safehouse, the crew argues over who comes along tonight. Every choice is a debt someone will collect on later — that's how it works in Marrowfen.",
      "art": "art-the-ashgrave-vault-the-plan-art",
      "options": [
        {
          "id": "bring-locksmith",
          "label": "Bring old Pello Fitch, Ashgrave's former apprentice",
          "visibleWhen": {
            "op": "always"
          },
          "target": "the-approach",
          "effects": [
            {
              "flag": "crew-pick",
              "value": "locksmith"
            }
          ]
        },
        {
          "id": "bring-charmer",
          "label": "Bring Sable, who can charm a guard as easily as a lock",
          "visibleWhen": {
            "op": "always"
          },
