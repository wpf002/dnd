    {
      "id": "inside-tallow-hall",
      "kind": "discovery",
      "title": "The Vigil's Shadow",
      "prose": "Inside, the hall is a maze of mourning drapes and candle smoke. Somewhere above, the vault holding the Mourning Seal waits behind whatever nightmare Ashgrave dreamed up for it.",
      "art": "art-the-ashgrave-vault-inside-hall-art",
      "options": [
        {
          "id": "search-stewards-office",
          "label": "Search the steward's office for the vault plans",
