    {
      "id": "final-fight",
      "kind": "conflict",
      "title": "Captain Dallow's Last Stand",
      "prose": "Captain Rooke Dallow blocks the grand stair with two guards at his back, sword already drawn. He hasn't been paid in weeks, but tonight he's decided to care anyway.",
      "art": "art-the-ashgrave-vault-final-fight-art",
      "options": [],
      "improvBudget": 6,
