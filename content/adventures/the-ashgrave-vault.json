        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": false
    },
    {
      "id": "vault-fight",
      "kind": "conflict",
      "title": "Bone Sentinels Awaken",
      "prose": "The dials click wrong, and the wall panels grind open. Ashgrave built his guardians from bone and stolen armor, and they've been waiting a long, patient time for this.",
      "art": "art-the-ashgrave-vault-vault-fight-art",
      "options": [],
      "improvBudget": 6,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "encounter": "bone-sentinels",
      "terminal": false
    },
    {
      "id": "seal-in-hand",
      "kind": "discovery",
      "title": "The Mourning Seal",
      "prose": "The seal sits in a velvet cradle, small and unremarkable for something that could unmake a duchy's debts. Somewhere in the hall, the music has stopped.",
      "art": "art-the-ashgrave-vault-seal-hand-art",
      "options": [
        {
