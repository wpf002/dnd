      "onExit": [],
      "terminal": false
    },
    {
      "id": "clean-escape",
      "kind": "ending",
      "title": "A Clean Getaway",
      "prose": "You're three streets away before the alarm bell finally rings. Nessa pays you a fraction of what the seal is worth — crime never pays well in Marrowfen — but you're alive, unshackled, and richer than yesterday. That'll do.",
      "art": "art-the-ashgrave-vault-clean-escape-art",
      "options": [],
      "improvBudget": 6,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": true
    },
    {
      "id": "bloody-escape",
      "kind": "ending",
      "title": "Blood on the Cobbles",
      "prose": "You stumble out of Tallow Hall bruised, bleeding, and short a few friends' good graces, but the seal is in your coat. Nessa pays you, wincing at the state of you. Word gets around Marrowfen fast: don't cross that crew.",
      "art": "art-the-ashgrave-vault-bloody-escape-art",
      "options": [],
      "improvBudget": 6,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": true
    },
    {
      "id": "captured-ending",
      "kind": "ending",
      "title": "The Duchy's Mercy",
      "prose": "Marrowfen's dungeons are as shabby as everything else in the duchy — damp, underfunded, and full of thieves who thought they had a clever plan. You'll have plenty of company to compare notes with.",
      "art": "art-the-ashgrave-vault-captured-ending-art",
      "options": [],
      "improvBudget": 6,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": true
    },
    {
      "id": "dukes-mercy-ending",
      "kind": "ending",
      "title": "An Uneasy Pardon",
      "prose": "The Duchess takes the seal back with trembling hands and, against all reason, lets you walk free. 'Marrowfen has enough debts,' she murmurs. 'I won't add yours to the pile.' Nessa is furious you didn't deliver it — but you sleep easier than she does.",
      "art": "art-the-ashgrave-vault-dukes-mercy-ending-art",
      "options": [],
      "improvBudget": 6,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": true
    },
    {
      "id": "betrayal-ending",
      "kind": "ending",
      "title": "The Seal for Silence",
      "prose": "The Duchess's composure cracks under your threats. You leave with the seal and her silence, both bought at the price of her trust. Nessa is delighted. You're not entirely sure you are.",
      "art": "art-the-ashgrave-vault-betrayal-ending-art",
      "options": [],
      "improvBudget": 6,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": true
    }
