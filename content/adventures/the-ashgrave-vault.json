    {
      "id": "duchess-confrontation",
      "kind": "climax",
      "title": "Face to Face with the Duchess",
      "prose": "Duchess Ilvara Marrow stands alone in the mourning hall, veil lifted, staring at the seal in your hand like it's the only honest thing left in her duchy.",
      "art": "art-the-ashgrave-vault-duchess-confrontation-art",
      "options": [
        {
          "id": "offer-mercy",
          "label": "Offer her the seal in exchange for mercy",
          "visibleWhen": {
