      "onExit": [],
      "terminal": false
    },
    {
      "id": "the-vault-room",
      "kind": "puzzle",
      "title": "Ashgrave's Puzzle Lock",
      "prose": "The vault door is a brass riddle of dials and levers, engraved with a warning in Ashgrave's cramped hand: 'A thief who thinks like me deserves what's inside.' It hums faintly, like it's waiting.",
      "art": "art-the-ashgrave-vault-vault-room-art",
      "options": [
        {
          "id": "use-the-plans",
          "label": "Use the plans to bypass the mechanism",
          "visibleWhen": {
            "op": "eq",
            "flag": "prep",
            "value": "plans"
          },
          "target": "seal-in-hand",
          "effects": []
        },
        {
          "id": "solve-the-riddle",
          "label": "Puzzle out the architect's riddle",
          "visibleWhen": {
            "op": "always"
          },
          "target": "seal-in-hand",
          "effects": [],
          "requiresCheck": {
            "ability": "intelligence",
            "skill": "investigation",
            "dc": 14,
            "onFailure": "vault-fight"
          }
        },
        {
