            "ability": "charisma",
            "skill": "intimidation",
            "dc": 14,
            "onFailure": "captured-ending"
          }
        },
        {
          "id": "smash-the-seal",
          "label": "Smash the seal before her eyes",
          "visibleWhen": {
            "op": "always"
