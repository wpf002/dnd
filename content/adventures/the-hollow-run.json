    {
      "id": "signal-beacon",
      "kind": "discovery",
      "title": "The Singing Light",
      "prose": "A cracked lighthouse rises from a reef that shouldn't exist on any chart, its lamp pulsing with a rhythm too regular to be natural.",
      "art": "art-the-hollow-run-signal-beacon",
      "options": [
        {
          "id": "examine-beacon-mechanism",
          "label": "Examine the beacon's inner workings",
          "target": "decode-beacon",
          "effects": []
        },
        {
          "id": "listen-for-transmission",
          "label": "Listen closely to the pulsing signal",
          "target": "decode-beacon",
          "effects": []
        },
        {
          "id": "search-wreckage-nearby",
          "label": "Search the wreckage scattered around the reef",
          "target": "decode-beacon",
          "effects": []
        }
