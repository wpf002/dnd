{
  "id": "the-hollow-run",
  "schemaVersion": 1,
  "metadata": {
    "title": "The Hollow Run",
    "premise": "A debt-ridden freighter crew is offered one desperate chance to clear their ledger: complete the Hollow Run, a smugglers' route through strange ports that has swallowed every ship that's tried it, and discover why — and whether there's still a reason to try again.",
    "tone": [
      "exploration",
      "heist"
    ],
    "tier": "local",
    "partyLevel": 4,
    "narrationVoice": "Wry, weathered dockhand narrator with a fondness for gallows humor and salt-air similes.",
    "contentLimits": {
      "exclude": [
        "harm to children depicted on-screen"
      ],
      "note": "No on-screen harm to children under any circumstance."
    },
    "provenance": "flint"
  },
  "entry": "dockside-ultimatum",
  "beats": [
    {
      "id": "dockside-ultimatum",
      "kind": "threshold",
      "title": "The Ledger Comes Due",
      "prose": "The freighter Gray Larkspur sits low at her moorings, hull groaning under debts nobody can pay. A broker in a rain-slick coat wants an answer by sundown: run the Hollow Run, or lose the ship.",
      "readAloud": "Rain drums on the deck as the broker taps a folded contract against his palm. 'Every crew that's tried the Hollow Run vanished. But debts don't care about odds, Captain. Do we have a deal?'",
      "art": "art-the-hollow-run-dockside-ultimatum",
      "options": [
        {
          "id": "meet-the-broker",
          "label": "Hear the broker's terms directly",
          "visibleWhen": {
            "op": "always"
          },
          "target": "broker-deal",
          "effects": []
        },
        {
          "id": "seek-a-rival-lender",
          "label": "Look for a rival financier to buy out the debt instead",
          "visibleWhen": {
            "op": "always"
          },
          "target": "loan-shark-office",
          "effects": []
        },
        {
          "id": "find-a-survivor",
          "label": "Track down the one person rumored to have come back from the Run",
          "visibleWhen": {
            "op": "always"
          },
          "target": "harbor-tavern",
          "effects": []
        }
      ],
      "improvBudget": 7,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": false
    },
    {
      "id": "broker-deal",
      "kind": "social",
      "title": "Ink and Interest",
      "prose": "Broker Vessic Calloway lays out the contract: the Run, or the ship is seized within the week. He seems to know more about the route than he admits.",
      "art": "art-the-hollow-run-broker-deal",
      "options": [
        {
          "id": "sign-terms",
          "label": "Sign the contract and take the assignment",
          "target": "chart-room",
          "effects": []
        },
        {
          "id": "press-calloway",
          "label": "Press Calloway on why he's so eager for this specific crew",
          "target": "chart-room",
          "effects": []
        },
        {
          "id": "demand-collateral",
          "label": "Demand equipment and coin up front as collateral",
          "target": "chart-room",
          "effects": []
        }
      ],
      "improvBudget": 6,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": false
    },
    {
      "id": "loan-shark-office",
      "kind": "social",
      "title": "A Second Vulture",
      "prose": "Financier Orsa Dreth is happy to buy the debt — for a price that trades one noose for another, and a whispered condition: she wants proof of what's really out on the Hollow Run.",
      "art": "art-the-hollow-run-loan-shark-office",
      "options": [
        {
          "id": "accept-dreths-terms",
          "label": "Accept Dreth's buyout and her strange condition",
          "target": "chart-room",
          "effects": []
        },
        {
          "id": "negotiate-dreth",
          "label": "Try to negotiate better terms",
          "target": "chart-room",
          "effects": []
        },
        {
          "id": "walk-away-from-dreth",
          "label": "Walk away and go back to Calloway's deal instead",
          "target": "chart-room",
          "effects": []
        }
      ],
      "improvBudget": 6,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": false
    },
    {
      "id": "harbor-tavern",
      "kind": "discovery",
      "title": "The Survivor's Warning",
      "prose": "Old Mirren lost her whole crew to the Hollow Run and came back alone, half-mad and muttering about a beacon that sings. She presses a hand-drawn map into your hands before you even ask.",
      "art": "art-the-hollow-run-harbor-tavern",
      "options": [
        {
          "id": "ask-mirren-details",
          "label": "Ask Mirren everything she remembers about the Run",
          "target": "chart-room",
          "effects": []
        },
        {
          "id": "buy-mirren-a-drink",
          "label": "Buy her a drink and let her talk at her own pace",
          "target": "chart-room",
          "effects": []
        },
        {
          "id": "take-the-map-and-go",
          "label": "Take the map and leave before she says something you can't unhear",
          "target": "chart-room",
          "effects": []
        }
      ],
      "improvBudget": 7,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [
        {
          "flag": "survivor-lead",
          "value": true
        }
      ],
      "onExit": [],
      "terminal": false
    },
    {
      "id": "chart-room",
      "kind": "decision",
      "title": "Plotting the Impossible Course",
      "prose": "Charts spread across the galley table. Three ways into the Hollow Run present themselves: through the fog banks unseen, through Saltspire's watch with the right bribe, or straight through the strait sailors call the Drowned Choir.",
      "art": "art-the-hollow-run-chart-room",
      "options": [
        {
          "id": "plan-stealth-fog",
          "label": "Slip through the fog banks unseen",
          "target": "fog-transit",
          "effects": []
        },
        {
          "id": "plan-bribe-wardens",
          "label": "Bribe the Saltspire port-wardens for safe passage",
          "target": "saltspire-port",
          "effects": []
        },
        {
          "id": "plan-brave-strait",
          "label": "Sail straight through the Drowned Choir strait",
          "target": "drowned-choir-ambush",
          "effects": []
        }
      ],
      "improvBudget": 8,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": false
    },
    {
      "id": "fog-transit",
      "kind": "transit",
      "title": "Into the Grey",
      "prose": "The fog swallows the horizon whole. Somewhere in it, something old is listening to the creak of your hull.",
