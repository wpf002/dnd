    {
      "id": "hollow-run-passage",
      "kind": "climax",
      "title": "The Heart of the Run",
      "prose": "Beyond the shrine, the true Hollow Run opens: a passage where the water itself seems to hold its breath, waiting to see if you're worth swallowing.",
      "art": "art-the-hollow-run-hollow-run-passage",
      "options": [
        {
          "id": "brave-storm-together",
          "label": "Push through the heart of the Run together",
