    },
    {
      "id": "decode-beacon",
      "kind": "puzzle",
      "title": "What the Light Is Saying",
      "prose": "The beacon isn't a warning. It's a summons, coded in pulses of light — and it's calling ships toward something that wants them to arrive.",
      "art": "art-the-hollow-run-decode-beacon",
      "options": [
        {
          "id": "use-survivor-map",
          "label": "Cross-reference the pattern against Old Mirren's map",
          "visibleWhen": {
            "op": "eq",
            "flag": "survivor-lead",
            "value": true
          },
          "target": "confront-cult-decision",
          "effects": [
            {
              "flag": "beacon-decoded",
              "value": true
            }
          ]
        },
        {
          "id": "attempt-cipher-solo",
          "label": "Work out the cipher yourselves",
          "target": "confront-cult-decision",
          "effects": [
            {
              "flag": "beacon-decoded",
              "value": true
            }
          ],
          "requiresCheck": {
            "ability": "intelligence",
            "skill": "Investigation",
            "dc": 15,
            "onFailure": "cult-ambush"
          }
        },
        {
          "id": "rally-crew-effort",
          "label": "Rally the whole crew to puzzle it out together",
          "target": "confront-cult-decision",
          "effects": [
            {
              "flag": "beacon-decoded",
              "value": true
            }
          ]
        }
      ],
      "improvBudget": 7,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": false
    },
    {
      "id": "confront-cult-decision",
      "kind": "decision",
      "title": "The Ledgerless Congregation",
      "prose": "The signal leads to a cult of ruined sailors who worship the thing beneath the Hollow Run, luring ships to feed it in exchange for calm passage for themselves. They know you're coming.",
      "art": "art-the-hollow-run-confront-cult-decision",
      "options": [
        {
          "id": "negotiate-with-cult",
          "label": "Try to negotiate a truce with the congregation",
          "target": "hollow-run-passage",
          "effects": [
            {
              "flag": "cult-negotiated",
              "value": true
            }
          ]
        },
        {
          "id": "sneak-heist-cargo",
          "label": "Sneak in and steal back what they've taken from other crews",
          "target": "hollow-run-passage",
          "effects": []
        },
        {
          "id": "fight-cult-directly",
          "label": "Fight your way through them",
          "target": "cult-ambush",
          "effects": []
        }
      ],
      "improvBudget": 8,
      "entryWhen": {
        "op": "eq",
        "flag": "beacon-decoded",
        "value": true
      },
      "onEntry": [],
