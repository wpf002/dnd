    {
      "id": "ending-triumphant-return",
      "kind": "ending",
      "title": "Debt Paid in Salt",
      "prose": "The Gray Larkspur breaks free of the Hollow Run into open water, hold full of recovered cargo and a story nobody will quite believe. The ledger is cleared, and for the first time in years, the crew sails without owing anyone a thing.",
      "art": "art-the-hollow-run-ending-triumphant-return",
      "options": [],
      "improvBudget": 6,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": true
    },
    {
      "id": "ending-sacrifice-escape",
      "kind": "ending",
      "title": "What the Run Takes",
      "prose": "You make it out — barely, and not with everything you brought in. The ship is battered, the cargo lost to the deep, but the crew is alive and breathing free air. The debt remains, but so do you, and that's a start.",
      "art": "art-the-hollow-run-ending-sacrifice-escape",
      "options": [],
      "improvBudget": 6,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": true
    },
    {
      "id": "ending-debt-consumed",
      "kind": "ending",
      "title": "Added to the Choir",
      "prose": "The Hollow Run keeps its record perfect. The Gray Larkspur joins the wrecks below, her crew's names added to whatever ledger the deep keeps for those who tried and failed.",
      "art": "art-the-hollow-run-ending-debt-consumed",
      "options": [],
