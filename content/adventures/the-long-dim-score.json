{
  "id": "the-long-dim-score",
  "schemaVersion": 1,
  "metadata": {
    "title": "The Long Dim Score",
    "premise": "In the haunted industrial city of Cinderfall, a crew has one night—the Long Dim, when the ghost-lights fail and the veil thins—to steal the Choir Key from the Hollowmere Exchange, a vault building designed by an architect who anticipated exactly this kind of theft.",
    "tone": [
      "heist",
      "urban-intrigue"
    ],
    "tier": "local",
    "partyLevel": 4,
    "narrationVoice": "wry, atmospheric noir narrator who savors the city's grime and ghosts",
    "contentLimits": {
      "exclude": [
        "harm to children depicted on-screen"
      ],
      "note": "No children are present in this scenario."
    },
    "provenance": "flint"
  },
  "entry": "crew-briefing",
  "beats": [
    {
      "id": "crew-briefing",
      "kind": "threshold",
      "title": "The Fixer's Offer",
      "prose": "The back room of the Choke & Ember reeks of tar-smoke. A fixer named Ondine Vask slides a folded schematic across the table: the Hollowmere Exchange, the vault beneath it, and the Choir Key that opens what nothing else can. Tonight the ghost-lights fail city-wide. Tonight is the Long Dim.",
      "readAloud": "\"One night a year the wardlights go dark and the dead walk closer to the living,\" Ondine says. \"That's your window. That's the whole job.\"",
      "art": "art-the-long-dim-score-crew-briefing-art",
      "options": [
        {
          "id": "take-job",
          "label": "Take the job as offered, no questions",
          "target": "casing-the-exchange",
          "effects": []
        },
        {
          "id": "grill-fixer",
          "label": "Press Ondine for the real story behind the Key",
          "target": "fixer-meeting",
          "effects": []
        },
        {
          "id": "loop-in-mara",
          "label": "Loop in loyal muscle Mara before moving",
          "target": "casing-the-exchange",
          "effects": [
            {
              "flag": "has-mara",
              "value": true
            }
          ]
        }
      ],
      "improvBudget": 7,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": false
    },
    {
      "id": "fixer-meeting",
      "kind": "social",
      "title": "What Ondine Knows",
      "prose": "Ondine's smile is thin. She talks about Vesper Thane, the architect who built Hollowmere—a man obsessed with the idea that someone, someday, would try exactly this. He died in the building's cellar. Some say he never left.",
      "art": "art-the-long-dim-score-fixer-meeting-art",
      "options": [
        {
          "id": "ask-wards",
          "label": "Ask what Thane built into the vault's wards",
          "target": "casing-the-exchange",
          "effects": [
            {
              "flag": "knows-wards",
              "value": true
            }
          ]
        },
        {
          "id": "ask-rivals-go-roof",
          "label": "Ask about the Ashgate Combine, then head straight for the rooftops yourself",
          "target": "rooftop-approach",
          "effects": []
        },
        {
          "id": "skip-chat",
          "label": "Cut the conversation short, there's no time",
          "target": "casing-the-exchange",
          "effects": []
        }
      ],
      "improvBudget": 6,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": false
    },
    {
      "id": "casing-the-exchange",
      "kind": "discovery",
      "title": "Casing Hollowmere",
      "prose": "The Exchange squats over the canal district like an iron tombstone, its windows dark even before the Long Dim. Patrol lanterns bob along three approaches: the flooded culvert beneath, the rain-chain gantries above, and the brass-doored front where night auditors still shuffle papers.",
      "art": "art-the-long-dim-score-casing-the-exchange-art",
      "options": [
        {
          "id": "go-sewer",
          "label": "Slip in through the old sewer culvert",
          "target": "sewer-approach",
          "effects": []
        },
        {
          "id": "go-roof",
          "label": "Climb the rain-chains to the roof",
          "target": "rooftop-approach",
          "effects": []
        },
        {
          "id": "go-front",
          "label": "Walk in disguised as night auditors",
          "target": "front-approach",
          "effects": []
        }
      ],
      "improvBudget": 7,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": false
    },
    {
      "id": "sewer-approach",
      "kind": "hazard",
      "title": "The Flooded Culvert",
      "prose": "Black water laps at the tunnel walls. Something down here has been dead a long while and hasn't noticed yet. Bones glimmer under the surface like a warning.",
      "art": "art-the-long-dim-score-sewer-approach-art",
      "options": [
        {
          "id": "wade-fast",
          "label": "Push through quickly before anything wakes",
          "target": "vault-antechamber",
          "effects": [],
