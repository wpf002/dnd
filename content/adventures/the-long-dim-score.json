    {
      "id": "front-alarm",
      "kind": "conflict",
      "title": "The Alarm Bell",
      "prose": "A bell shrieks through the lobby. Ashgate Combine mercs pour from a side office, blades already drawn — they've been waiting for someone to try this exact door.",
      "art": "art-the-long-dim-score-front-alarm-art",
