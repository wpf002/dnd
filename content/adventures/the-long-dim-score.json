    {
      "id": "front-approach",
      "kind": "social",
      "title": "The Brass Doors",
      "prose": "Two night auditors flank a brass-barred door, ledgers in hand, faces gray with fatigue and worse things. A guard station's lantern flickers, undecided about the dark.",
      "art": "art-the-long-dim-score-front-approach-art",
      "options": [
        {
          "id": "bluff-clerk",
          "label": "Bluff past the night clerk with a forged manifest",
