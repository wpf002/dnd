    {
      "id": "sewer-ambush",
      "kind": "conflict",
      "title": "Something in the Water",
      "prose": "The water churns. Rotted hands break the surface, and eyes that have not blinked in decades fix on the crew.",
      "art": "art-the-long-dim-score-sewer-ambush-art",
      "options": [],
