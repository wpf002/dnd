    {
      "id": "rooftop-approach",
      "kind": "hazard",
      "title": "The Rain-Chain Gantries",
      "prose": "Iron gantries sway over a hundred-foot drop into the canal. Wardlanterns hang dead on their hooks. Somewhere above, boots scuff on wet metal.",
      "art": "art-the-long-dim-score-rooftop-approach-art",
      "options": [
        {
          "id": "sprint-gantries",
          "label": "Sprint across before the patrol turns",
