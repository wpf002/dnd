    },
    {
      "id": "ghost-thane-encounter",
      "kind": "climax",
      "title": "The Architect's Unquiet Guard",
      "prose": "The rods scream a discordant note. Shadows peel from the walls, and at their center rises a withered shape in a foreman's coat: Vesper Thane, or what's left binding itself to his own design.",
      "art": "art-the-long-dim-score-ghost-thane-encounter-art",
      "options": [],
      "improvBudget": 8,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "encounter": "ghost-thane-encounter",
      "terminal": false
    },
    {
      "id": "vault-open",
      "kind": "decision",
      "title": "What the Vault Holds",
      "prose": "Inside: the Choir Key's twin, and beside it a ledger of names — every magistrate, every crew boss, every debt Cinderfall pretends it doesn't owe. This was never just a heist.",
      "readAloud": "The ledger's ink is still wet, somehow, after all these years. Someone has been adding to it.",
      "art": "art-the-long-dim-score-vault-open-art",
      "options": [
        {
          "id": "torch-vault",
          "label": "Take the ledger and Key, torch the vault to bury the truth",
          "target": "ending-burn-it-down",
          "effects": []
        },
        {
          "id": "give-mara-ledger",
          "label": "Take only the Key, leave the ledger for the neighborhood to use",
          "target": "ending-mara-alliance",
          "effects": []
        },
        {
          "id": "take-everything",
          "label": "Grab everything and vanish, sell it to the highest bidder",
          "target": "ending-betrayal",
          "effects": []
        }
      ],
      "improvBudget": 7,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": false
    },
    {
      "id": "ending-burn-it-down",
      "kind": "ending",
      "title": "Ash Over Hollowmere",
      "prose": "The Exchange burns through the night, its secrets going up with it. The crew walks away rich and unnamed, and Cinderfall never learns what almost surfaced. Some truths, you decide, are safer as smoke.",
      "art": "art-the-long-dim-score-ending-burn-art",
      "options": [],
      "improvBudget": 5,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": true
    },
    {
      "id": "ending-mara-alliance",
      "kind": "ending",
      "title": "The Ledger's Weight",
      "prose": "The names in that ledger reach every doorstep in the canal district by morning. Cinderfall's bosses scramble, exposed. The crew keeps the Key and Mara's trust — and a city's worth of enemies who now know your face.",
      "art": "art-the-long-dim-score-ending-mara-art",
      "options": [],
      "improvBudget": 5,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": true
    },
    {
      "id": "ending-betrayal",
      "kind": "ending",
      "title": "Everything Has a Price",
      "prose": "You take it all — Key, ledger, and the silence to match. Somewhere in the city, someone very rich is now very interested in you, for reasons that will follow the crew long after the Long Dim ends.",
      "art": "art-the-long-dim-score-ending-betrayal-art",
      "options": [],
      "improvBudget": 5,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": true
    },
    {
      "id": "crew-scattered",
      "kind": "ending",
      "title": "Left in the Dark",
      "prose": "The Long Dim ends the way it began: with the wardlights guttering back on over a city that never noticed you were there. Whatever's left of the crew scatters into Cinderfall's alleys, the job unfinished and the Key still buried in Hollowmere's dark.",
      "art": "art-the-long-dim-score-crew-scattered-art",
      "options": [],
      "improvBudget": 5,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": true
    }
