    {
      "id": "vault-antechamber",
      "kind": "puzzle",
      "title": "The Singing Door",
      "prose": "A door of tuned brass rods blocks the vault, humming faintly even in the dead air of the Long Dim. Vesper Thane built it to answer only to a particular sound — or to punish whoever guesses wrong.",
      "art": "art-the-long-dim-score-vault-antechamber-art",
      "options": [
        {
          "id": "attune-key",
          "label": "Use the Choir Key, attuning it by ear",
          "target": "vault-open",
          "effects": [],
          "requiresCheck": {
            "ability": "wis",
            "skill": "perception",
            "dc": 14,
            "onFailure": "ghost-thane-encounter"
          }
        },
        {
          "id": "force-mechanism",
          "label": "Force the mechanism open with tools",
          "target": "vault-open",
          "effects": [],
          "requiresCheck": {
            "ability": "str",
            "skill": "athletics",
            "dc": 15,
            "onFailure": "ghost-thane-encounter"
          }
        },
        {
          "id": "recall-wards",
          "label": "Recall what Ondine said about Thane's wards",
          "visibleWhen": {
            "op": "eq",
