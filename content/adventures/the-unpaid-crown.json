{
  "id": "the-unpaid-crown",
  "schemaVersion": 1,
  "metadata": {
    "title": "The Unpaid Crown",
    "premise": "When Baron Aldric of Veskmoor dies leaving a crushing war-debt owed to the rival Barony of Corrin, his estranged heir's succession hinges on a treaty that favors no one and a debt that cannot be paid honestly.",
    "tone": [
      "political-fantasy",
      "exploration"
    ],
    "tier": "regional",
    "partyLevel": 5,
    "narrationVoice": "a wry, atmospheric chronicler of court intrigue and old grudges",
    "contentLimits": {
      "exclude": [
        "harm to children depicted on-screen"
      ],
      "note": "No on-screen harm to children under any circumstance."
    },
    "provenance": "flint"
  },
  "entry": "arrival-at-veskmoor",
  "beats": [
    {
      "id": "arrival-at-veskmoor",
      "kind": "threshold",
      "title": "Ashes at Veskmoor Keep",
      "prose": "The funeral bells of Veskmoor toll over a keep already fracturing. Baron Aldric is dead, his debt to the Barony of Corrin unpaid, and his heir untested. You have been summoned to bear witness — or to intervene.",
      "readAloud": "Black banners snap in the wind above Veskmoor's gate. Somewhere within, a ledger of blood and coin awaits a reckoning no one wants to make.",
      "art": "art-the-unpaid-crown-arrival-veskmoor",
      "options": [
        {
          "id": "opt-arrival-ledger",
          "label": "Examine the ledger hall for the debt records",
          "visibleWhen": {
            "op": "always"
          },
          "target": "ledger-hall",
          "effects": []
        },
        {
          "id": "opt-arrival-shrine",
          "label": "Request audience with the grieving heir at the shrine",
          "visibleWhen": {
            "op": "always"
          },
          "target": "shrine-audience",
          "effects": []
        },
        {
          "id": "opt-arrival-barracks",
          "label": "Speak with the garrison captain in the barracks",
          "visibleWhen": {
            "op": "always"
          },
          "target": "barracks-warning",
          "effects": []
        }
      ],
      "improvBudget": 8,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": false
    },
    {
      "id": "ledger-hall",
      "kind": "discovery",
      "title": "The Forged Ledger",
      "prose": "Dust and candle-wax choke the ledger hall. The debt entries to Corrin have been altered — someone padded the sum, and recently.",
      "art": "art-the-unpaid-crown-ledger-hall",
      "options": [
        {
          "id": "opt-ledger-confront",
          "label": "Confront the steward about the forged entries now",
          "visibleWhen": {
            "op": "always"
          },
          "target": "steward-showdown",
          "effects": []
        },
        {
          "id": "opt-ledger-copy",
          "label": "Quietly copy the forged entries as evidence",
          "visibleWhen": {
            "op": "always"
          },
          "target": "council-summons",
          "effects": [
            {
              "flag": "has-evidence",
              "value": true
            }
          ]
        },
        {
          "id": "opt-ledger-report",
          "label": "Leave to report your findings to the heir",
          "visibleWhen": {
            "op": "always"
          },
          "target": "shrine-audience",
          "effects": []
        }
      ],
      "improvBudget": 7,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": false
    },
    {
