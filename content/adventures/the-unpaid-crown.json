      "kind": "social",
      "title": "The Grieving Heir",
      "prose": "Lady Ysenne kneels before her father's shrine, more frightened than sorrowful. She needs allies, not mourners.",
      "art": "art-the-unpaid-crown-shrine-audience",
      "options": [
        {
          "id": "opt-shrine-pledge",
          "label": "Pledge your sword to the heir's claim",
          "visibleWhen": {
            "op": "always"
          },
          "target": "council-summons",
          "effects": [
            {
              "flag": "has-heir-trust",
              "value": true
            }
          ]
        },
        {
          "id": "opt-shrine-demand",
          "label": "Demand proof of the heir's legitimacy",
          "visibleWhen": {
            "op": "always"
          },
          "target": "council-summons",
          "effects": []
        },
        {
          "id": "opt-shrine-barracks",
          "label": "Excuse yourself to speak with the garrison",
          "visibleWhen": {
            "op": "always"
          },
          "target": "barracks-warning",
