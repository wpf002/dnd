      "kind": "ending",
      "title": "A Fragile Peace",
      "prose": "Ashmere passes to Corrin under seal and witness. It costs Veskmoor land, but buys it years of uneasy, genuine peace, and Lady Ysenne rules with your name spoken as ally.",
      "art": "art-the-unpaid-crown-ending-alliance",
      "options": [],
      "improvBudget": 5,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
