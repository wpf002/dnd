    {
      "id": "treaty-vault",
      "kind": "puzzle",
      "title": "The Treaty Vault",
      "prose": "Old parchment and older wax seals. Somewhere in this clause-tangled treaty lies a way out — or a way to make one.",
      "art": "art-the-unpaid-crown-treaty-vault",
      "options": [
        {
          "id": "opt-vault-decipher",
          "label": "Decipher the treaty's true clause",
          "visibleWhen": {
            "op": "always"
          },
          "target": "corrin-envoy",
          "effects": [],
          "requiresCheck": {
            "ability": "int",
            "skill": "history",
            "dc": 14,
            "onFailure": "council-summons"
          }
        },
        {
          "id": "opt-vault-forge",
          "label": "Alter the treaty's wording before anyone notices",
          "visibleWhen": {
            "op": "always"
          },
          "target": "debt-reckoning",
          "effects": []
        },
        {
          "id": "opt-vault-leave",
          "label": "Leave the vault undisturbed, heeding the captain's warning",
          "visibleWhen": {
            "op": "eq",
            "flag": "has-bribed-captain",
            "value": true
          },
          "target": "corrin-envoy",
          "effects": []
        }
      ],
      "improvBudget": 8,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": false
