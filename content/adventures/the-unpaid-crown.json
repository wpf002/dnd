      "kind": "social",
      "title": "Corrin's Envoy",
      "prose": "The envoy of Corrin, cloaked in grey and silver, waits with a patience that feels like a blade held to the throat of the barony.",
      "art": "art-the-unpaid-crown-corrin-envoy",
      "options": [
        {
          "id": "opt-envoy-honest",
          "label": "Negotiate honestly, presenting evidence of the forged debt",
          "visibleWhen": {
            "op": "eq",
