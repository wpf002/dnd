    {
      "id": "council-summons",
      "kind": "decision",
      "title": "The Baronial Council",
      "prose": "The council gathers beneath the fractured seal of Veskmoor. Corrin's envoy waits at the gate. A decision on the debt must begin to take shape.",
      "art": "art-the-unpaid-crown-council-summons",
      "options": [
        {
          "id": "opt-council-advocate",
          "label": "Advocate for the heir before the assembled barons",
          "visibleWhen": {
            "op": "eq",
            "flag": "has-heir-trust",
            "value": true
          },
          "target": "corrin-envoy",
          "effects": []
        },
        {
          "id": "opt-council-vault",
          "label": "Slip away to search the treaty vault for a loophole",
          "visibleWhen": {
            "op": "always"
          },
          "target": "treaty-vault",
          "effects": []
        },
        {
          "id": "opt-council-land",
          "label": "Propose settling the debt with border land outright",
          "visibleWhen": {
            "op": "always"
          },
          "target": "debt-reckoning",
          "effects": []
        }
      ],
      "improvBudget": 7,
      "entryWhen": {
