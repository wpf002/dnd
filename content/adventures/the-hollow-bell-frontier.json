{
  "id": "the-hollow-bell-frontier",
  "schemaVersion": 1,
  "metadata": {
    "title": "The Hollow Bell Frontier",
    "premise": "In the raucous boomtown of Sixnail Crossing, two estranged godling brothers have let their ancient grudge boil over, and a cult means to wake the vengeful one from beneath a cracked bell before the whole valley is claimed as payment on a divine debt.",
    "tone": [
      "high-adventure",
      "exploration"
    ],
    "tier": "regional",
    "partyLevel": 4,
    "narrationVoice": "Wry, weather-beaten campfire storyteller who treats gods like unruly neighbors and danger like good gossip.",
    "contentLimits": {
      "exclude": [
        "harm to children depicted on-screen"
      ],
      "note": "Keep threats to adults, livestock, and property; no children placed in on-screen danger."
    },
    "provenance": "flint"
  },
  "entry": "sixnail-crossing",
  "beats": [
    {
      "id": "sixnail-crossing",
      "kind": "threshold",
      "title": "The Crossing at Harvest's Edge",
      "prose": "Sixnail Crossing sprawls where two dead riverbeds meet, its shanties strung with charms to two gods who no longer speak to each other. Grain-gold banners for Kest the Reaping Star snap beside black mourning-cloth for his brother Orune, the Hollow Bell. Something in the ground is humming wrong today, and everyone pretends not to notice.",
      "readAloud": "The wind smells of turned earth and old iron. Somewhere below the boardwalks, a bell that shouldn't be able to ring is ringing anyway.",
      "art": "art-the-hollow-bell-frontier-sixnail-crossing-art",
      "options": [
        {
          "id": "seek-warden",
          "label": "Seek out the Harvest Warden for counsel",
