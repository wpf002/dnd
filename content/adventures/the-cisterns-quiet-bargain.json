    {
      "id": "guild-hall",
      "kind": "social",
      "title": "Matron Corvain's Ledger",
      "prose": "The guild hall smells of solder and lamp oil. Matron Corvain, hands stained black from her forges, admits she needs the Cistern Warden's seal to legally claim the water rights her workers have kept flowing for free for a decade. She doesn't want the temple or the manor to know the guild is this desperate.",
      "art": "art-the-cisterns-quiet-bargain-guild-hall-art",
      "options": [
        {
          "id": "pledge-corvain",
          "label": "Offer quiet help to Matron Corvain",
          "visibleWhen": {
            "op": "always"
          },
          "target": "ward-archive",
          "effects": [
            {
              "flag": "allegiance",
              "value": "corvain"
            }
          ]
        },
        {
          "id": "press-corvain",
          "label": "Press her about who else wants the seal",
