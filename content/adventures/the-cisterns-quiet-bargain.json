{
  "id": "the-cisterns-quiet-bargain",
  "schemaVersion": 1,
  "metadata": {
    "title": "The Cistern's Quiet Bargain",
    "premise": "In the flood-worn wards of Draygate, three powers—the Tinkers' Guild, the Drowned Bell temple, and an absentee lord's steward—each quietly need the same forgotten seal, and each is desperate that the other two never learn why.",
    "tone": [
      "urban-intrigue",
      "political-fantasy"
    ],
    "tier": "local",
    "partyLevel": 4,
    "narrationVoice": "A wry, street-level narrator who knows every alley's going price.",
    "contentLimits": {
      "exclude": [
        "harm to children depicted on-screen"
      ],
      "note": "No violence toward or endangerment of children is ever depicted."
    },
    "provenance": "flint"
  },
  "entry": "entry-salt-row",
  "beats": [
    {
      "id": "entry-salt-row",
      "kind": "threshold",
      "title": "Three Petitioners, One Secret",
      "prose": "Old Ferro slides three names across a stained table in Salt Row: Matron Ilsa Corvain of the Tinkers' Guild, Deacon Ashur Vey of the Drowned Bell, and Steward Renna Oswick of absentee Lord Thale. Each has quietly asked around the wards for the same small tin seal—the old Cistern Warden's mark—and each has offered coin for silence. Ferro wants to know why, and who'll pay best to keep it that way.",
      "readAloud": "The rain drums on tin roofs as Ferro taps the table. 'Three of the city's quiet powers, all chasing the same trinket. Pick a door, and mind you don't let the other two see you knock.'",
      "art": "art-the-cisterns-quiet-bargain-entry-salt-row-art",
      "options": [
        {
          "id": "go-guild-hall",
          "label": "Follow the lead to the Tinkers' Guild hall",
