    {
      "id": "decision-final",
      "kind": "decision",
      "title": "The Seal in Your Hand",
      "prose": "The seal's weight is more than tin. Whoever holds it decides who controls the ward's water for a generation—or whether anyone does at all.",
      "art": "art-the-cisterns-quiet-bargain-decision-final-art",
