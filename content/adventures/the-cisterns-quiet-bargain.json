    {
      "id": "ending-guild-rule",
      "kind": "ending",
      "title": "The Guild's Water",
      "prose": "Matron Corvain grips the seal like a promise kept. The wards' cisterns will run under guild oversight now—fairer than the manor, harder-edged than the temple, but yours to have shaped. Salt Row will remember who chose them.",
      "art": "art-the-cisterns-quiet-bargain-ending-guild-rule-art",
      "options": [],
      "improvBudget": 6,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": true
    },
    {
      "id": "ending-temple-rule",
      "kind": "ending",
      "title": "The Bell Endures",
      "prose": "Deacon Vey seals the vault properly this time, the old binding renewed under the Drowned Bell's care. The water stays sweet, the spirit stays quiet, and the temple's quiet influence over the wards grows a little deeper.",
      "art": "art-the-cisterns-quiet-bargain-ending-temple-rule-art",
      "options": [],
      "improvBudget": 6,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": true
    },
    {
      "id": "ending-independent-ward",
      "kind": "ending",
      "title": "No One's Seal",
      "prose": "You burn the claim ledgers in a rain barrel and let the truth of the binding spread through Salt Row's gossip instead of its courts. No single power gets the water. The wards argue, organize, and—slowly—govern themselves.",
      "art": "art-the-cisterns-quiet-bargain-ending-independent-ward-art",
      "options": [],
      "improvBudget": 6,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": true
    },
    {
      "id": "ending-oswick-rule",
      "kind": "ending",
      "title": "The Absentee Lord's Hand",
      "prose": "Oswick takes the seal with a satisfied nod and folds the ward's water into Lord Thale's distant estate. The wards get a new landlord who has never once visited them. Your coin purse is heavier; your welcome in Salt Row is not.",
      "art": "art-the-cisterns-quiet-bargain-ending-oswick-rule-art",
      "options": [],
      "improvBudget": 6,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": true
    },
    {
      "id": "ending-defeat",
      "kind": "ending",
      "title": "Lost Beneath the Wards",
      "prose": "Between old bones and hired blades, the ward finally claims something back. The seal is never found again, and the three powers quietly go on wanting it, and wondering.",
      "art": "art-the-cisterns-quiet-bargain-ending-defeat-art",
      "options": [],
      "improvBudget": 6,
