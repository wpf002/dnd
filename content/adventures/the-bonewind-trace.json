    {
      "id": "vault-choice",
      "kind": "decision",
      "title": "The Spring's Price",
      "prose": "Vashka is fallen and the spring is finally yours, but the vault holds more than water: bound captives, an old relic half-buried at the spring's edge, and a choice about what you leave behind.",
      "art": "art-the-bonewind-trace-vault-choice-spring",
      "options": [
        {
          "id": "free-captives",
          "label": "Free the captives and lead everyone back with the water",
