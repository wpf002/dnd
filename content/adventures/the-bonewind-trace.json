    {
      "id": "stone-alignment-puzzle",
      "kind": "puzzle",
      "title": "Aligning the Stones",
      "prose": "A ring of standing stones surrounds a sunken basin. Rees's notes, old lore, or sheer force might reveal the path down into the dark beneath them.",
      "art": "art-the-bonewind-trace-stone-alignment-ritual",
      "options": [
        {
          "id": "use-map-notes",
          "label": "Use Rees's map notes to align the stones",
          "visibleWhen": {
            "op": "eq",
            "flag": "has-map-clue",
            "value": true
          },
          "target": "vault-entrance",
          "effects": []
        },
