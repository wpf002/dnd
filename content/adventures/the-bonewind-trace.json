{
  "id": "the-bonewind-trace",
  "schemaVersion": 1,
  "metadata": {
    "title": "The Bonewind Trace",
    "premise": "A desert caravan road bristling with outlaws and ancient standing stones hides a spring that could save a dying waystation, but every scout sent down its southern fork has vanished without a trace.",
    "tone": [
      "exploration",
      "mystery"
    ],
    "tier": "local",
    "partyLevel": 4,
    "narrationVoice": "A weathered desert guide narrates in terse, sun-scoured prose, equal parts dry wit and reverence for the old stones that watch the road.",
    "contentLimits": {
      "exclude": [
        "harm to children depicted on-screen"
      ]
    },
    "provenance": "flint"
  },
  "entry": "contract-at-waystation",
  "beats": [
    {
      "id": "contract-at-waystation",
      "kind": "threshold",
      "title": "The Waystation Contract",
      "prose": "Duskwell Waystation huddles at the edge of the dunes, its well running dry. The elder Marsha Coth offers what coin remains to any who will ride the Bonewind Trace and find Rees Fallow, the cartographer who vanished chasing rumors of a hidden spring among the standing stones.",
      "readAloud": "Nobody who takes the southern fork comes back the same road they left on. But the well is dry, and dry wells make desperate offers.",
      "art": "art-the-bonewind-trace-waystation-contract",
      "options": [
        {
          "id": "hear-elder-warning",
          "label": "Hear the elder's full warning about the Trace",
          "target": "elder-warning",
          "effects": []
        },
        {
          "id": "head-out-at-once",
          "label": "Head out at once toward the standing stones",
          "target": "trace-crossroads",
          "effects": []
        },
        {
          "id": "ask-about-rees",
          "label": "Ask about Rees Fallow, the missing cartographer",
          "target": "rees-backstory",
          "effects": []
        }
      ],
      "improvBudget": 7,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": false
    },
    {
      "id": "elder-warning",
      "kind": "social",
      "title": "The Elder's Warning",
      "prose": "Marsha Coth's hands shake as she describes the Trace: outlaws called the Salt Hand Riders who tax every traveler, and stones older than any road that seem to move when watched too long.",
      "art": "art-the-bonewind-trace-elder-warning-scene",
      "options": [
        {
          "id": "ask-toll",
          "label": "Ask about the Salt Hand Riders' toll",
          "target": "trace-crossroads",
          "effects": [
            {
              "flag": "knows-toll",
              "value": true
            }
          ]
        },
        {
          "id": "ask-stones",
          "label": "Ask about the standing stones' history",
          "target": "trace-crossroads",
          "effects": [
            {
              "flag": "knows-stones",
              "value": true
            }
          ]
        },
        {
          "id": "cut-talk-short",
          "label": "Cut the talk short, time is short",
          "target": "trace-crossroads",
          "effects": []
        }
      ],
      "improvBudget": 6,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [
        {
          "flag": "helped-elder",
          "value": true
        }
      ],
      "onExit": [],
      "terminal": false
    },
    {
      "id": "rees-backstory",
      "kind": "social",
      "title": "The Cartographer's Trail",
      "prose": "The waystation folk remember Rees fondly: obsessive about the old stones, convinced a hidden aquifer lay beneath them, and gone six weeks past with only a mule and a battered satchel.",
      "art": "art-the-bonewind-trace-rees-backstory-scene",
      "options": [
        {
          "id": "see-sketches",
          "label": "Ask to see Rees's old sketches",
          "target": "trace-crossroads",
          "effects": [
            {
              "flag": "has-map-clue",
              "value": true
            }
          ]
        },
        {
          "id": "ask-planned-route",
          "label": "Ask what route he planned to take",
          "target": "trace-crossroads",
          "effects": [
            {
              "flag": "knows-stones",
              "value": true
            }
          ]
        },
        {
          "id": "thank-and-move-on",
          "label": "Thank them and move on",
          "target": "trace-crossroads",
          "effects": []
        }
      ],
      "improvBudget": 6,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [
        {
          "flag": "knows-rees",
          "value": true
        }
      ],
      "onExit": [],
      "terminal": false
    },
    {
      "id": "trace-crossroads",
      "kind": "decision",
      "title": "Where the Trace Splits",
      "prose": "The road forks below a lone standing stone. One path runs open beneath the sun, one is a hidden goat-trail you've heard mentioned, and a third climbs toward distant campfire smoke.",
      "art": "art-the-bonewind-trace-trace-crossroads-view",
      "options": [
        {
          "id": "take-open-road",
          "label": "Take the open road past the first standing stone",
          "target": "first-standing-stone",
          "effects": []
        },
        {
          "id": "follow-hidden-trail",
          "label": "Follow a hidden trail you learned of, bypassing the toll",
          "visibleWhen": {
            "op": "eq",
            "flag": "knows-stones",
            "value": true
          },
          "target": "rees-camp",
          "effects": []
        },
        {
          "id": "march-toward-smoke",
          "label": "March straight for the smoke of a bandit camp",
          "target": "bandit-toll-post",
          "effects": []
        }
      ],
      "improvBudget": 7,
