{
  "id": "beyond-the-last-line",
  "schemaVersion": 1,
  "metadata": {
    "title": "Beyond the Last Line",
    "premise": "Past the frontier town of Hollow Ford, the map runs out and only rumor remains: a vanished expedition, a grove that glows at night, and a vein of strange silver ore said to hum like a struck bell. The party must go where no map has been drawn.",
    "tone": [
      "west-marches",
      "exploration"
    ],
    "tier": "local",
    "partyLevel": 3,
    "narrationVoice": "A weathered frontier scout speaking directly to the listener in low, practical second person, equal parts warning and wonder.",
    "contentLimits": {
      "exclude": [
        "harm to children depicted on-screen"
      ],
      "note": "No children appear on-screen in danger; any references to families are handled off-page."
    },
    "provenance": "flint"
  },
  "entry": "edge-of-the-map",
  "beats": [
    {
      "id": "edge-of-the-map",
      "kind": "threshold",
      "title": "Where the Map Ends",
      "prose": "The last surveyor's post marks the edge of Hollow Ford's charts. Beyond it, the trail forks into unmarked wilderness, and the only guidance left is rumor.",
