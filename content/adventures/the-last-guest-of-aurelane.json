{
  "id": "the-last-guest-of-aurelane",
  "schemaVersion": 1,
  "metadata": {
    "title": "The Last Guest of Aurelane",
    "premise": "The resort city of Aurelane never lets its guests leave — until the one night a year the Farewell Gala thins its wards, and a single object called the Departure Key can buy a way out, if it can be stolen from the building its own architect designed to stop exactly this.",
    "tone": [
      "heist",
      "mystery"
    ],
    "tier": "regional",
    "partyLevel": 4,
    "narrationVoice": "A honey-voiced resort announcer who never stops smiling, even when describing the guests who never checked out",
    "contentLimits": {
      "exclude": [
        "harm to children depicted on-screen"
      ],
      "note": "No children appear on-screen; any references to families are handled off-page."
    },
    "provenance": "flint"
  },
  "entry": "arrival-gala",
  "beats": [
    {
      "id": "arrival-gala",
      "kind": "threshold",
      "title": "The Farewell Gala",
      "prose": "Lanterns of captured starlight drift over the Grand Terminus ballroom. Tonight is the one night Aurelane's wards thin — the Farewell Gala, when the resort pretends its guests might actually go home. You know better. You've heard the rumors of a Departure Key, an object the architect Ozren Vantal built into his masterpiece before he vanished. Somewhere in this glittering trap is your only way out.",
      "readAloud": "Champagne flutes chime like distant bells. Above the dance floor, the ceiling shows a painted sky that has never once matched the real one outside.",
      "art": "art-the-last-guest-of-aurelane-grand-ballroom-gala",
      "options": [
        {
          "id": "talk-to-concierge",
          "label": "Corner the resort's concierge for answers",
          "visibleWhen": {
            "op": "always"
          },
          "target": "talk-concierge",
          "effects": []
        },
        {
          "id": "slip-into-corridors",
          "label": "Slip away into the service corridors",
          "visibleWhen": {
            "op": "always"
          },
          "target": "service-corridors",
          "effects": []
        },
        {
          "id": "approach-the-host",
          "label": "Approach the Warden who hosts this gala",
          "visibleWhen": {
            "op": "always"
          },
          "target": "host-audience",
          "effects": []
        }
      ],
      "improvBudget": 8,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": false
    },
    {
      "id": "talk-concierge",
      "kind": "social",
      "title": "The Concierge's Smile",
      "prose": "The concierge, a pale man named Farel with too many pockets, answers every question with another question, but a slip of the tongue mentions 'the Key' and 'the architect's study' before he catches himself.",
      "art": "art-the-last-guest-of-aurelane-concierge-desk",
      "options": [
        {
          "id": "ask-about-key",
          "label": "Press him about the Departure Key",
          "visibleWhen": {
            "op": "always"
          },
          "target": "architects-study",
          "effects": []
        },
        {
          "id": "ask-about-warden",
          "label": "Ask what the Warden really wants",
          "visibleWhen": {
            "op": "always"
          },
          "target": "host-audience",
          "effects": []
        },
        {
          "id": "slip-away",
          "label": "Excuse yourself before he grows suspicious",
          "visibleWhen": {
            "op": "always"
          },
          "target": "service-corridors",
          "effects": []
        }
      ],
      "improvBudget": 7,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": false
    },
    {
      "id": "service-corridors",
      "kind": "discovery",
      "title": "Behind the Velvet",
      "prose": "Past the gilded doors, the resort's bones show: bare stone, humming sconces, and staff who move like clockwork. A locked archive door promises answers, but every footstep echoes further than it should.",
      "art": "art-the-last-guest-of-aurelane-service-corridor-shadows",
      "options": [
        {
          "id": "pick-lock-archive",
          "label": "Pick the archive lock and slip through",
          "visibleWhen": {
            "op": "always"
          },
          "target": "archive-vault",
          "effects": [],
          "requiresCheck": {
            "ability": "dex",
            "skill": "stealth",
            "dc": 13,
            "onFailure": "patrol-encounter"
          }
        },
        {
          "id": "continue-search",
          "label": "Search further, even if it means noise",
          "visibleWhen": {
            "op": "always"
          },
          "target": "architects-study",
          "effects": [
            {
              "flag": "staff-suspicious",
              "value": true
            }
          ]
        },
        {
          "id": "retreat-to-gala",
          "label": "Retreat and rejoin the audience with the Warden",
          "visibleWhen": {
            "op": "always"
          },
          "target": "host-audience",
          "effects": []
        }
      ],
      "improvBudget": 8,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": false
    },
    {
      "id": "host-audience",
      "kind": "social",
      "title": "The Warden's Welcome",
      "prose": "Warden Selessa Thorn greets you with a warmth that never reaches her eyes. She speaks of Aurelane as a 'family' no one truly leaves, and studies your party as though deciding how you'll be remembered — or preserved.",
      "art": "art-the-last-guest-of-aurelane-warden-audience-hall",
      "options": [
        {
          "id": "press-for-truth",
          "label": "Press her directly about the Departure Key",
          "visibleWhen": {
            "op": "always"
          },
          "target": "confront-warden",
          "effects": []
        },
        {
          "id": "play-along",
          "label": "Play the grateful guest and gather clues quietly",
          "visibleWhen": {
            "op": "always"
          },
          "target": "architects-study",
          "effects": []
        },
        {
          "id": "excuse-yourself",
          "label": "Excuse yourself back into the corridors",
          "visibleWhen": {
            "op": "always"
          },
          "target": "service-corridors",
          "effects": []
        }
      ],
      "improvBudget": 7,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [
        {
          "flag": "met-warden",
          "value": true
        }
      ],
      "onExit": [],
      "terminal": false
    },
    {
      "id": "architects-study",
      "kind": "discovery",
      "title": "Vantal's Study",
      "prose": "Dust-caked blueprints cover every wall of the architect's abandoned study. Ozren Vantal designed Aurelane to hold its guests forever — and left, half-mad with guilt, a single flaw: the Departure Key, hidden in the Terminus vault.",
      "art": "art-the-last-guest-of-aurelane-architect-study-blueprints",
      "options": [
        {
          "id": "study-blueprints",
          "label": "Study the vault mechanism in detail",
          "visibleWhen": {
            "op": "always"
          },
          "target": "vault-mechanism",
          "effects": []
        },
        {
          "id": "pocket-key-fragment",
          "label": "Pocket a fragment and head straight for the vault",
          "visibleWhen": {
            "op": "always"
          },
          "target": "archive-vault",
          "effects": []
        },
        {
          "id": "report-findings",
          "label": "Bring your findings straight to the Warden",
          "visibleWhen": {
            "op": "always"
          },
          "target": "confront-warden",
          "effects": []
        }
      ],
      "improvBudget": 8,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [
        {
          "flag": "has-blueprints",
          "value": true
        }
      ],
      "onExit": [],
      "terminal": false
    },
    {
      "id": "confront-warden",
      "kind": "decision",
      "title": "A Question of Leverage",
      "prose": "Whatever you know now, it changes how the Warden looks at you — as a threat, a bargaining chip, or an opportunity. The choice of how to press her is yours, and it will not be undone.",
      "art": "art-the-last-guest-of-aurelane-warden-confrontation",
      "options": [
        {
          "id": "demand-release",
          "label": "Demand she open the wards herself",
          "visibleWhen": {
            "op": "eq",
            "flag": "staff-suspicious",
            "value": false
          },
          "target": "warden-standoff",
          "effects": []
        },
        {
          "id": "negotiate-terms",
          "label": "Offer her something she wants in trade",
          "visibleWhen": {
            "op": "always"
          },
          "target": "bribe-doorman",
          "effects": []
        },
        {
          "id": "flee-confrontation",
          "label": "Break off and head for the vault yourself",
          "visibleWhen": {
            "op": "always"
          },
          "target": "archive-vault",
          "effects": []
        }
      ],
      "improvBudget": 7,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": false
    },
    {
      "id": "bribe-doorman",
      "kind": "social",
      "title": "A Price for Passage",
      "prose": "A weary doorman named Coss has watched guests vanish for thirty years. He hates Aurelane more than he fears it — for the right price, or the right promise, he'll help you move unseen.",
      "art": "art-the-last-guest-of-aurelane-doorman-bribe",
      "options": [
        {
          "id": "offer-coin",
          "label": "Offer him enough coin to vanish himself",
          "visibleWhen": {
            "op": "always"
          },
          "target": "archive-vault",
          "effects": [
            {
              "flag": "recruited-ally",
              "value": true
            }
          ]
        },
        {
          "id": "offer-secret",
          "label": "Offer him a secret way out for himself and others",
          "visibleWhen": {
            "op": "always"
          },
          "target": "vault-mechanism",
          "effects": [
            {
              "flag": "recruited-ally",
              "value": true
            }
          ]
        },
        {
          "id": "decline-help",
          "label": "Decline his help and go it alone",
          "visibleWhen": {
            "op": "always"
          },
          "target": "archive-vault",
          "effects": []
        }
      ],
      "improvBudget": 6,
