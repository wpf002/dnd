    {
      "id": "escape-terminus",
      "kind": "decision",
      "title": "The Departure Key",
      "prose": "The Key rests warm and impossible in your hand — a sliver of hinge-metal that should not exist, humming with the promise of an exit. The wards are thinning. Dawn, and choice, are almost here.",
      "art": "art-the-last-guest-of-aurelane-terminus-departure-hall",
      "options": [
        {
          "id": "slip-through-alone",
          "label": "Slip through the thinning ward alone, Key in hand",
          "visibleWhen": {
            "op": "always"
          },
          "target": "ending-freedom",
          "effects": []
        },
        {
          "id": "signal-the-guests",
          "label": "Signal every trapped guest and lead a mass escape",
          "visibleWhen": {
            "op": "eq",
            "flag": "recruited-ally",
            "value": true
          },
          "target": "ending-mass-exodus",
          "effects": []
        },
        {
          "id": "claim-the-mantle",
          "label": "Use the Key to claim the Warden's mantle instead",
          "visibleWhen": {
            "op": "eq",
            "flag": "met-warden",
            "value": true
          },
          "target": "ending-become-warden",
          "effects": []
        }
      ],
      "improvBudget": 7,
      "entryWhen": {
        "op": "eq",
        "flag": "key-stolen",
        "value": true
      },
      "onEntry": [],
      "onExit": [],
      "terminal": false
    },
    {
      "id": "ending-freedom",
      "kind": "ending",
      "title": "Free at Last",
      "prose": "The ward parts like a curtain of warm smoke, and beyond it is a road, an ordinary road, leading away from Aurelane's painted sky. You walk it without looking back, the Key already dissolving to ash in your pocket.",
      "readAloud": "Behind you, the lanterns of the Farewell Gala dim one by one, as though the city itself is disappointed to see you go.",
      "art": "art-the-last-guest-of-aurelane-dawn-departure",
      "options": [],
      "improvBudget": 5,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": true
    },
    {
      "id": "ending-mass-exodus",
      "kind": "ending",
      "title": "The Grand Exodus",
      "prose": "Word spreads through the resort like wildfire. Guests who forgot they were prisoners remember all at once, and a river of people pours toward the thinning ward. Aurelane cannot hold what no longer believes in its walls.",
      "readAloud": "Coss the doorman is the last through, laughing like a man who has waited thirty years for this single joke to land.",
      "art": "art-the-last-guest-of-aurelane-guests-exodus-dawn",
      "options": [],
      "improvBudget": 5,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": true
    },
    {
      "id": "ending-become-warden",
      "kind": "ending",
      "title": "The New Warden",
      "prose": "You do not leave. You close your hand around the Key and feel Aurelane's wards answer to you instead, Selessa Thorn's tired relief evident as she finally, finally passes the burden on. The resort has a new host now, and new rules to write.",
      "readAloud": "Somewhere, the painted sky above the ballroom shifts subtly to match your reflection in the glass.",
      "art": "art-the-last-guest-of-aurelane-new-warden-throne",
      "options": [],
      "improvBudget": 5,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": true
    },
    {
      "id": "ending-trapped-forever",
      "kind": "ending",
      "title": "Guest of Aurelane, Forever",
      "prose": "The clockwork hands close around you before the ward finishes thinning. Selessa's smile returns, sad and permanent, as staff lead you gently, irresistibly, back toward the gala that will never, ever end.",
      "readAloud": "A new name is already being embroidered onto a fresh set of resort linens, waiting for you in a room that always knew you'd stay.",
      "art": "art-the-last-guest-of-aurelane-eternal-guest-suite",
      "options": [],
      "improvBudget": 5,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
      "onExit": [],
      "terminal": true
    }
  ],
