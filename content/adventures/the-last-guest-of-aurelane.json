    {
      "id": "archive-vault",
      "kind": "discovery",
      "title": "The Vault Antechamber",
      "prose": "Beyond a final door, brass gears the size of wagon wheels turn behind glass. The Departure Key rests somewhere within this mechanism, guarded by Vantal's last, cruelest joke of an invention.",
      "art": "art-the-last-guest-of-aurelane-archive-vault-door",
      "options": [
        {
          "id": "examine-vault-door",
          "label": "Examine the vault mechanism directly",
          "visibleWhen": {
            "op": "always"
          },
          "target": "vault-mechanism",
          "effects": []
        },
        {
          "id": "search-side-chamber",
          "label": "Search a side chamber for the architect's notes",
          "visibleWhen": {
            "op": "always"
          },
          "target": "architects-study",
          "effects": []
        },
        {
          "id": "retreat-to-gala",
          "label": "Slip back toward the gala to reconsider",
          "visibleWhen": {
            "op": "always"
          },
          "target": "talk-concierge",
          "effects": []
