      "terminal": false
    },
    {
      "id": "vault-mechanism",
      "kind": "puzzle",
      "title": "The Clockwork Lock",
      "prose": "The vault is a puzzle of gears, mirrors, and false floors — Vantal's final design, meant to keep the Key from anyone clever enough to reach it. It hums as though it recognizes you.",
      "art": "art-the-last-guest-of-aurelane-vault-mechanism-puzzle",
      "options": [
        {
          "id": "use-blueprints-shortcut",
          "label": "Use the architect's blueprints to bypass the gears entirely",
          "visibleWhen": {
            "op": "eq",
            "flag": "has-blueprints",
            "value": true
          },
          "target": "escape-terminus",
          "effects": [
            {
              "flag": "key-stolen",
              "value": true
            }
          ]
        },
        {
          "id": "force-mechanism",
          "label": "Force the mechanism open by brute strength",
          "visibleWhen": {
