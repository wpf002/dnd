      "terminal": false
    },
    {
      "id": "warden-standoff",
      "kind": "conflict",
      "title": "The Warden's Enforcers",
      "prose": "Selessa Thorn's smile finally cracks. Her bandit-captain enforcer and a pair of hobgoblin bruisers step between you and the vault, and for the first time tonight, Aurelane shows its teeth.",
      "art": "art-the-last-guest-of-aurelane-warden-standoff-battle",
      "options": [],
      "improvBudget": 6,
      "entryWhen": {
        "op": "always"
      },
      "onEntry": [],
