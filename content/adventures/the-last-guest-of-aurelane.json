    },
    {
      "id": "patrol-encounter",
      "kind": "conflict",
      "title": "Clockwork Patrol",
      "prose": "Suits of animated livery-armor round the corner, brass faces blank and gleaming. They do not shout. They simply advance, gears whirring, to herd you back where you belong.",
      "art": "art-the-last-guest-of-aurelane-corridor-patrol-fight",
      "options": [],
      "improvBudget": 6,
      "entryWhen": {
        "op": "always"
      },
